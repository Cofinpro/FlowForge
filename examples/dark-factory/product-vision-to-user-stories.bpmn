    <bpmn:callActivity id="Call_PG2" name="Phasen-Gate-Review: Validierung" calledElement="Process_PG"><bpmn:extensionElements><sdlc:step key="PG2" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:critic rubric="gate-validierung" threshold="0.8" maxLoops="3" /></bpmn:extensionElements><bpmn:incoming>F_09</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="G-P2" name="Problem &amp; Nutzerreise validiert?"><bpmn:extensionElements><sdlc:gate kind="phase-panel" recordRequired="true" /><sdlc:condition expr="pivotCount &lt; 2" /></bpmn:extensionElements><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_P2_ja</bpmn:outgoing><bpmn:outgoing>F_P2_research</bpmn:outgoing><bpmn:outgoing>F_P2_pivot</bpmn:outgoing><bpmn:outgoing>F_P2_nogo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_Mapping"><bpmn:incoming>F_P2_ja</bpmn:incoming><bpmn:incoming>F_P3_nachschaerfen</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP4.1" name="4.1 Story Mapping Workshop: Backbone &amp; Epics strukturieren"><bpmn:documentation>Rolle: Backlog-Autor / UX / QA / Architekt. Input: Artefakt 5. Output: Backbone (Epics/User Tasks).</bpmn:documentation><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing><bpmn:laneSet id="LaneSet_SP4.1"><bpmn:lane id="Lane_SP4.1_backlog-autor" name="Backlog-Autor"><bpmn:flowNodeRef>SP4.1_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SP4.1_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>S4.1.1</bpmn:flowNodeRef><bpmn:flowNodeRef>S4.1.3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP4.1_ux" name="UX-/Journey-Designer"><bpmn:flowNodeRef>S4.1.2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP4.1_qa" name="QA-Perspektive"><bpmn:flowNodeRef>S4.1.4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP4.1_architekt" name="Architekt"><bpmn:flowNodeRef>S4.1.5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP4.1_kritiker" name="Kritiker"><bpmn:flowNodeRef>SP4.1_CallK</bpmn:flowNodeRef><bpmn:flowNodeRef>SP4.1_Gw</bpmn:flowNodeRef><bpmn:flowNodeRef>SP4.1_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
