    <bpmn:serviceTask id="S6.1.1" name="Confirmation-Kriterien festhalten"><bpmn:extensionElements><sdlc:step key="S6.1.1" agentRole="backlog-autor" modelRole="producer" kind="llm" /><sdlc:input artifact="story-refined" required="true" /><sdlc:output artifact="ac-draft" /></bpmn:extensionElements><bpmn:incoming>S6.1.1_in</bpmn:incoming><bpmn:outgoing>S6.1.2_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S6.1.2" name="Mit konkreten Beispielen spezifizieren (SBE)"><bpmn:extensionElements><sdlc:step key="S6.1.2" agentRole="qa" modelRole="producer" kind="llm" /><sdlc:input artifact="ac-draft" required="true" /><sdlc:input artifact="personas" required="true" /><sdlc:output artifact="sbe-examples" /><sdlc:panel mode="rating" panelSet="full" optional="true" /></bpmn:extensionElements><bpmn:incoming>S6.1.2_in</bpmn:incoming><bpmn:outgoing>S6.1.3_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S6.1.3" name="In Given-When-Then formalisieren"><bpmn:extensionElements><sdlc:step key="S6.1.3" agentRole="qa" modelRole="producer" kind="llm" /><sdlc:input artifact="sbe-examples" required="true" /><sdlc:output artifact="acceptance-criteria" itemPrefix="AC" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>S6.1.3_in</bpmn:incoming><bpmn:outgoing>S6.1.4_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S6.1.4" name="Fachliche vs. technische Testerwartungen abgleichen"><bpmn:extensionElements><sdlc:step key="S6.1.4" agentRole="architekt" modelRole="producer" kind="llm" /><sdlc:input artifact="acceptance-criteria" required="true" /><sdlc:output artifact="acceptance-criteria" itemPrefix="AC" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>S6.1.4_in</bpmn:incoming><bpmn:outgoing>SP6.1_F_toK</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:callActivity id="SP6.1_CallK" name="Kritiker-Pruefung aufrufen (gherkin)" calledElement="Process_K"><bpmn:extensionElements><sdlc:step key="SP6.1.K" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:critic rubric="gherkin" threshold="0.8" maxLoops="3" /></bpmn:extensionElements><bpmn:incoming>SP6.1_F_toK</bpmn:incoming><bpmn:outgoing>SP6.1_F_toGw</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP6.1_Gw" name="Testbar &amp; eindeutig?"><bpmn:incoming>SP6.1_F_toGw</bpmn:incoming><bpmn:outgoing>SP6.1_F_ja</bpmn:outgoing><bpmn:outgoing>SP6.1_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP6.1_End" name="Akzeptanzkriterien (BDD) verfasst"><bpmn:incoming>SP6.1_F_ja</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="SP6.1_F0" sourceRef="SP6.1_Start" targetRef="SP6.1_Merge" />
