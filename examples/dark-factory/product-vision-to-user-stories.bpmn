    <bpmn:callActivity id="Call_R3" name="Recherche: Domaene, Prozesse &amp; Regulatorik (DR-03)" calledElement="Process_R"><bpmn:documentation>Rolle: Researcher. Ruft Process_R auf (Gemini Deep Research, Korpusaufbau). Laeuft vor der Customer-Journey-Kartierung (3.1); bei erneutem Durchlauf (G-P2 "Mehr Research", Pivot) im Gap-Fill-Modus ohne neuen Deep-Research-Aufruf (Gedaechtnis SS8.5).</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R3" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:output artifact="research-domaene-prozesse-regulatorik" /><sdlc:research tool="deep-research" purpose="corpus" ref="DR-03" /></bpmn:extensionElements><bpmn:incoming>F_08</bpmn:incoming><bpmn:outgoing>F_08b</bpmn:outgoing></bpmn:callActivity><bpmn:subProcess id="SP3.1" name="3.1 Customer Journey kartieren (Current vs. Future State)"><bpmn:documentation>Rolle: UX / Architekt. Input: Artefakt 4. Output: Artefakt 5.</bpmn:documentation><bpmn:incoming>F_08b</bpmn:incoming><bpmn:outgoing>F_09</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutAssoc_DO_A5"><bpmn:targetRef>DataRef_DO_A5</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:laneSet id="LaneSet_SP3.1"><bpmn:lane id="Lane_SP3.1_ux" name="UX-/Journey-Designer"><bpmn:flowNodeRef>SP3.1_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SP3.1_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>S3.1.1</bpmn:flowNodeRef><bpmn:flowNodeRef>S3.1.2</bpmn:flowNodeRef><bpmn:flowNodeRef>S3.1.3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP3.1_architekt" name="Architekt"><bpmn:flowNodeRef>S3.1.4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP3.1_kritiker" name="Kritiker"><bpmn:flowNodeRef>SP3.1_CallK</bpmn:flowNodeRef><bpmn:flowNodeRef>SP3.1_Gw</bpmn:flowNodeRef><bpmn:flowNodeRef>SP3.1_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="SP3.1_Start" name="Gestartet"><bpmn:outgoing>SP3.1_F0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP3.1_Merge"><bpmn:incoming>SP3.1_F0</bpmn:incoming><bpmn:incoming>SP3.1_F_nein</bpmn:incoming><bpmn:outgoing>S3.1.1_in</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S3.1.1" name="Current-State-Journey kartieren"><bpmn:extensionElements><sdlc:step key="S3.1.1" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="personas" required="true" /><sdlc:input artifact="jtbd" required="true" /><sdlc:input artifact="research-domaene-prozesse-regulatorik" required="true" /><sdlc:output artifact="journey-current" /><sdlc:panel mode="walkthrough" panelSet="full" optional="false" /></bpmn:extensionElements><bpmn:incoming>S3.1.1_in</bpmn:incoming><bpmn:outgoing>S3.1.2_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S3.1.2" name="Hot Spots &amp; Friktionspunkte markieren"><bpmn:extensionElements><sdlc:step key="S3.1.2" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="journey-current" required="true" /><sdlc:input artifact="pains-gains" required="true" /><sdlc:output artifact="hot-spots" itemPrefix="HS" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>S3.1.2_in</bpmn:incoming><bpmn:outgoing>S3.1.3_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S3.1.3" name="Future-State-Journey entwerfen"><bpmn:extensionElements><sdlc:step key="S3.1.3" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="hot-spots" required="true" /><sdlc:input artifact="opportunity-backlog" required="true" /><sdlc:output artifact="journey-future" /><sdlc:panel mode="walkthrough" panelSet="full" optional="false" /></bpmn:extensionElements><bpmn:incoming>S3.1.3_in</bpmn:incoming><bpmn:outgoing>S3.1.4_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S3.1.4" name="Service Blueprint schichten"><bpmn:extensionElements><sdlc:step key="S3.1.4" agentRole="architekt" modelRole="producer" kind="llm" /><sdlc:input artifact="journey-future" required="true" /><sdlc:input artifact="idea-brief" required="true" /><sdlc:output artifact="service-blueprint" /><sdlc:research tool="websearch" purpose="factcheck" /></bpmn:extensionElements><bpmn:incoming>S3.1.4_in</bpmn:incoming><bpmn:outgoing>SP3.1_F_toK</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:callActivity id="SP3.1_CallK" name="Kritiker-Pruefung aufrufen (phase-3-1)" calledElement="Process_K"><bpmn:extensionElements><sdlc:step key="SP3.1.K" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:critic rubric="phase-3-1" threshold="0.8" maxLoops="3" /></bpmn:extensionElements><bpmn:incoming>SP3.1_F_toK</bpmn:incoming><bpmn:outgoing>SP3.1_F_toGw</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP3.1_Gw" name="Future State ohne untragbare Backstage-Komplexitaet?"><bpmn:incoming>SP3.1_F_toGw</bpmn:incoming><bpmn:outgoing>SP3.1_F_ja</bpmn:outgoing><bpmn:outgoing>SP3.1_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP3.1_End" name="Customer Journey &amp; Service Blueprint kartiert"><bpmn:incoming>SP3.1_F_ja</bpmn:incoming></bpmn:endEvent>
