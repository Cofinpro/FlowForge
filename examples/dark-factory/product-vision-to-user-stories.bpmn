    <bpmn:exclusiveGateway id="SP56_Gw" name="Story erfuellt INVEST &amp; DoR?"><bpmn:incoming>SP56_F2</bpmn:incoming><bpmn:outgoing>SP56_F_ja</bpmn:outgoing><bpmn:outgoing>SP56_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP6.1" name="6.1 Akzeptanzkriterien verfassen"><bpmn:documentation>Rolle: QA / Backlog-Autor / Architekt (Three-Amigos-Perspektiven). Input: veredelte Story (5.2). Format: BDD / Given-When-Then.</bpmn:documentation><bpmn:incoming>SP56_F_ja</bpmn:incoming><bpmn:outgoing>SP56_F3</bpmn:outgoing><bpmn:laneSet id="LaneSet_SP6.1"><bpmn:lane id="Lane_SP6.1_backlog-autor" name="Backlog-Autor"><bpmn:flowNodeRef>SP6.1_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.1_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.1.1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP6.1_qa" name="QA-Perspektive"><bpmn:flowNodeRef>S6.1.2</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.1.3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP6.1_architekt" name="Architekt"><bpmn:flowNodeRef>S6.1.4</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP6.1_kritiker" name="Kritiker"><bpmn:flowNodeRef>SP6.1_CallK</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.1_Gw</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.1_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="SP6.1_Start" name="Gestartet"><bpmn:outgoing>SP6.1_F0</bpmn:outgoing></bpmn:startEvent>
