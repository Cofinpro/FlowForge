    <bpmn:sequenceFlow id="S3.1.2_in" sourceRef="S3.1.1" targetRef="S3.1.2" />
    <bpmn:sequenceFlow id="S3.1.3_in" sourceRef="S3.1.2" targetRef="S3.1.3" />
    <bpmn:sequenceFlow id="S3.1.4_in" sourceRef="S3.1.3" targetRef="S3.1.4" />
