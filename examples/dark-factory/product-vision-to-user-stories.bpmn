    <bpmn:subProcess id="SP6.2" name="6.2 Backlog-Konsistenz &amp; Alignment pruefen"><bpmn:documentation>Rolle: Traceability-Pruefer / Kritiker. Input: Akzeptanzkriterien (6.1), Epics/Impact Map, User Story Map. Laeuft einmal ueber den gesamten Backlog (nicht Multi-Instance). Output: Artefakt 7.</bpmn:documentation><bpmn:incoming>F_18</bpmn:incoming><bpmn:outgoing>F_19</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutAssoc_DO_A7"><bpmn:targetRef>DataRef_DO_A7</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:laneSet id="LaneSet_SP6.2"><bpmn:lane id="Lane_SP6.2_traceability" name="Traceability-Pruefer"><bpmn:flowNodeRef>SP6.2_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.2_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.2.1</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.2.2</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.2.5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP6.2_kritiker" name="Kritiker"><bpmn:flowNodeRef>S6.2.3</bpmn:flowNodeRef><bpmn:flowNodeRef>S6.2.4</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.2_CallK</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.2_Gw</bpmn:flowNodeRef><bpmn:flowNodeRef>SP6.2_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="SP6.2_Start" name="Gestartet"><bpmn:outgoing>SP6.2_F0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP6.2_Merge"><bpmn:incoming>SP6.2_F0</bpmn:incoming><bpmn:incoming>SP6.2_F_nein</bpmn:incoming><bpmn:outgoing>S6.2.1_in</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="S6.2.1" name="Story -&gt; Epic-Traceability pruefen"><bpmn:documentation>Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="S6.2.1" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:input artifact="story-cards" required="true" /><sdlc:input artifact="backbone" required="true" /><sdlc:output artifact="trace-findings" /></bpmn:extensionElements><bpmn:incoming>S6.2.1_in</bpmn:incoming><bpmn:outgoing>S6.2.2_in</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="S6.2.2" name="Epic -&gt; Impact / Vision-Traceability pruefen"><bpmn:documentation>Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="S6.2.2" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:input artifact="backbone" required="true" /><sdlc:input artifact="impacts" required="true" /><sdlc:input artifact="business-goals" required="true" /><sdlc:input artifact="vision-statement" required="true" /><sdlc:output artifact="trace-findings" /></bpmn:extensionElements><bpmn:incoming>S6.2.2_in</bpmn:incoming><bpmn:outgoing>S6.2.3_in</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:businessRuleTask id="S6.2.3" name="Ubiquitous-Language-Konsistenz pruefen"><bpmn:extensionElements><sdlc:step key="S6.2.3" agentRole="kritiker" modelRole="producer" kind="llm" /><sdlc:input artifact="acceptance-criteria" required="true" /><sdlc:output artifact="glossary" itemPrefix="TERM" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>S6.2.3_in</bpmn:incoming><bpmn:outgoing>S6.2.4_in</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="S6.2.4" name="Orphan- &amp; Fake-Stories aussortieren"><bpmn:extensionElements><sdlc:step key="S6.2.4" agentRole="kritiker" modelRole="producer" kind="llm" /><sdlc:input artifact="trace-findings" required="true" /><sdlc:output artifact="backlog-cleaned" /></bpmn:extensionElements><bpmn:incoming>S6.2.4_in</bpmn:incoming><bpmn:outgoing>S6.2.5_in</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:scriptTask id="S6.2.5" name="Traceability-Matrix erzeugen"><bpmn:documentation>Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="S6.2.5" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:input artifact="backlog-cleaned" required="true" /><sdlc:output artifact="traceability-matrix" /></bpmn:extensionElements><bpmn:incoming>S6.2.5_in</bpmn:incoming><bpmn:outgoing>SP6.2_F_toK</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:callActivity id="SP6.2_CallK" name="Kritiker-Pruefung aufrufen (traceability)" calledElement="Process_K"><bpmn:extensionElements><sdlc:step key="SP6.2.K" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:critic rubric="traceability" threshold="0.8" maxLoops="3" /></bpmn:extensionElements><bpmn:incoming>SP6.2_F_toK</bpmn:incoming><bpmn:outgoing>SP6.2_F_toGw</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP6.2_Gw" name="Konsistent, rueckverfolgbar &amp; DoR erfuellt?"><bpmn:incoming>SP6.2_F_toGw</bpmn:incoming><bpmn:outgoing>SP6.2_F_ja</bpmn:outgoing><bpmn:outgoing>SP6.2_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP6.2_End" name="Konsistenzpruefung durchgefuehrt"><bpmn:incoming>SP6.2_F_ja</bpmn:incoming></bpmn:endEvent>
