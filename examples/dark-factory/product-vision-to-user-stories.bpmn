    <bpmn:exclusiveGateway id="SP2.1_Gw" name="Rollen &amp; Jobs durch Quellen &amp; Transkripte belegt?"><bpmn:incoming>SP2.1_F_toGw</bpmn:incoming><bpmn:outgoing>SP2.1_F_ja</bpmn:outgoing><bpmn:outgoing>SP2.1_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP2.1_End" name="Personas &amp; JTBD ermittelt"><bpmn:incoming>SP2.1_F_ja</bpmn:incoming></bpmn:endEvent>
