    <bpmn:subProcess id="SP2.2" name="2.2 Empathy Mapping &amp; Problem Definition"><bpmn:documentation>Rolle: UX / Stratege. Input: Personas &amp; JTBD (Artefakt 3). Output: Artefakt 4.</bpmn:documentation><bpmn:incoming>F_07</bpmn:incoming><bpmn:outgoing>F_08</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutAssoc_DO_A4"><bpmn:targetRef>DataRef_DO_A4</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:laneSet id="LaneSet_SP2.2"><bpmn:lane id="Lane_SP2.2_ux" name="UX-/Journey-Designer"><bpmn:flowNodeRef>SP2.2_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>SP2.2_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>S2.2.1</bpmn:flowNodeRef><bpmn:flowNodeRef>S2.2.2</bpmn:flowNodeRef><bpmn:flowNodeRef>S2.2.3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP2.2_stratege" name="Stratege"><bpmn:flowNodeRef>S2.2.4</bpmn:flowNodeRef><bpmn:flowNodeRef>S2.2.5</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_SP2.2_kritiker" name="Kritiker"><bpmn:flowNodeRef>SP2.2_CallK</bpmn:flowNodeRef><bpmn:flowNodeRef>SP2.2_Gw</bpmn:flowNodeRef><bpmn:flowNodeRef>SP2.2_End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="SP2.2_Start" name="Gestartet"><bpmn:outgoing>SP2.2_F0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="SP2.2_Merge"><bpmn:incoming>SP2.2_F0</bpmn:incoming><bpmn:incoming>SP2.2_F_nein</bpmn:incoming><bpmn:outgoing>S2.2.1_in</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S2.2.1" name="Empathy Maps erstellen"><bpmn:extensionElements><sdlc:step key="S2.2.1" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="personas" required="true" /><sdlc:input artifact="interview-transcripts" required="true" /><sdlc:output artifact="empathy-maps" /><sdlc:panel mode="rating" panelSet="full" optional="true" /></bpmn:extensionElements><bpmn:incoming>S2.2.1_in</bpmn:incoming><bpmn:outgoing>S2.2.2_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S2.2.2" name="Pains &amp; Gains extrahieren"><bpmn:extensionElements><sdlc:step key="S2.2.2" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="empathy-maps" required="true" /><sdlc:output artifact="pains-gains" itemPrefix="PAIN" /></bpmn:extensionElements><bpmn:incoming>S2.2.2_in</bpmn:incoming><bpmn:outgoing>S2.2.3_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S2.2.3" name="Point of View &amp; How-Might-We formulieren"><bpmn:extensionElements><sdlc:step key="S2.2.3" agentRole="ux" modelRole="producer" kind="llm" /><sdlc:input artifact="pains-gains" required="true" /><sdlc:output artifact="pov-hmw" itemPrefix="HMW" /></bpmn:extensionElements><bpmn:incoming>S2.2.3_in</bpmn:incoming><bpmn:outgoing>S2.2.4_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="S2.2.4" name="Opportunity-Solution-Tree aufbauen"><bpmn:extensionElements><sdlc:step key="S2.2.4" agentRole="stratege" modelRole="producer" kind="llm" /><sdlc:input artifact="pov-hmw" required="true" /><sdlc:input artifact="business-goals" required="true" /><sdlc:output artifact="opportunity-solution-tree" itemPrefix="OPP" /></bpmn:extensionElements><bpmn:incoming>S2.2.4_in</bpmn:incoming><bpmn:outgoing>S2.2.5_in</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:callActivity id="S2.2.5" name="Opportunities priorisieren"><bpmn:extensionElements><sdlc:step key="S2.2.5" agentRole="stratege" modelRole="producer" kind="llm" /><sdlc:input artifact="opportunity-solution-tree" required="true" /><sdlc:output artifact="opportunity-backlog" /><sdlc:panel mode="rating" panelSet="full" optional="false" /></bpmn:extensionElements><bpmn:incoming>S2.2.5_in</bpmn:incoming><bpmn:outgoing>SP2.2_F_toK</bpmn:outgoing></bpmn:callActivity>
    <bpmn:callActivity id="SP2.2_CallK" name="Kritiker-Pruefung aufrufen (phase-2-2)" calledElement="Process_K"><bpmn:extensionElements><sdlc:step key="SP2.2.K" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:critic rubric="phase-2-2" threshold="0.8" maxLoops="3" /></bpmn:extensionElements><bpmn:incoming>SP2.2_F_toK</bpmn:incoming><bpmn:outgoing>SP2.2_F_toGw</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="SP2.2_Gw" name="Problem loesungsneutral &amp; fokussiert?"><bpmn:incoming>SP2.2_F_toGw</bpmn:incoming><bpmn:outgoing>SP2.2_F_ja</bpmn:outgoing><bpmn:outgoing>SP2.2_F_nein</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="SP2.2_End" name="Opportunity Backlog priorisiert"><bpmn:incoming>SP2.2_F_ja</bpmn:incoming></bpmn:endEvent>
