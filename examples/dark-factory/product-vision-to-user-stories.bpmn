    <bpmn:exclusiveGateway id="Merge_NoGo"><bpmn:incoming>F_P1_nogo</bpmn:incoming><bpmn:incoming>F_P2_nogo</bpmn:incoming><bpmn:outgoing>F_NoGo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_NoGo" name="No-Go-Report erstellen"><bpmn:documentation>Rolle: Traceability-Pruefer. Input: Gate-Record des No-Go (G-P1/G-P2). Output: Run-Report mit Status discarded (Begruendung, Evidenzmix, offene Kill-Annahmen, Kosten, Pivot-Historie); kein Backlog-Export, keine Veroeffentlichung.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="NoGo.1" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:output artifact="run-report" /></bpmn:extensionElements><bpmn:incoming>F_NoGo</bpmn:incoming><bpmn:outgoing>F_NoGo_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_IdeeVerworfen" name="Idee verworfen"><bpmn:incoming>F_NoGo_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="SP_Budget" name="Budget erschoepft" triggeredByEvent="true"><bpmn:documentation>Event-Sub-Prozess (unterbrechender Error-Start), ueberwacht den gesamten Lauf. Rolle: Traceability-Pruefer.</bpmn:documentation><bpmn:startEvent id="SP_Budget_Start" name="Budget erschoepft (Fehler)" isInterrupting="true"><bpmn:outgoing>SP_Budget_F1</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorDef_Budget" errorRef="Error_BudgetErschoepft" /></bpmn:startEvent>
    <bpmn:serviceTask id="SP_Budget_S1" name="Teilergebnis sichern &amp; Run-Report erstellen"><bpmn:documentation>Rolle: Traceability-Pruefer. Sichert alle bisherigen Artefakte und markiert den Run-Report als Teilergebnis.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="Budget.1" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:output artifact="run-report" /></bpmn:extensionElements><bpmn:incoming>SP_Budget_F1</bpmn:incoming><bpmn:outgoing>SP_Budget_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="SP_Budget_End" name="Budget erschoepft (Teilergebnis)"><bpmn:incoming>SP_Budget_F2</bpmn:incoming></bpmn:endEvent>
