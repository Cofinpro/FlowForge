    <bpmn:serviceTask id="S7" name="7 Abschluss: Backlog exportieren &amp; Run-Report erstellen"><bpmn:documentation>Rolle: Traceability-Pruefer. Input: Artefakt 7 (bereinigter Backlog).</bpmn:documentation><bpmn:extensionElements><sdlc:step key="7" agentRole="traceability" modelRole="producer" kind="llm" /><sdlc:input artifact="backlog-cleaned" required="true" /><sdlc:output artifact="backlog-export" /><sdlc:output artifact="run-report" /></bpmn:extensionElements><bpmn:incoming>F_62_ja</bpmn:incoming><bpmn:outgoing>F_20</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutAssoc_DO_A8"><bpmn:targetRef>DataRef_DO_A8</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
