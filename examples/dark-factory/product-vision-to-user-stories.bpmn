    <bpmn:sequenceFlow id="F_02" sourceRef="Merge_P1" targetRef="SP1.1" />
    <bpmn:sequenceFlow id="F_03" sourceRef="SP1.1" targetRef="SP1.2" />
    <bpmn:sequenceFlow id="F_04" sourceRef="SP1.2" targetRef="Call_PG1" />
    <bpmn:sequenceFlow id="F_05" sourceRef="Call_PG1" targetRef="G-P1" />
    <bpmn:sequenceFlow id="F_P1_ja" sourceRef="G-P1" targetRef="Merge_Research" name="Ja" />
    <bpmn:sequenceFlow id="F_P1_nachschaerfen" sourceRef="G-P1" targetRef="Merge_P1" name="Nachschaerfen" />
    <bpmn:sequenceFlow id="F_P1_nogo" sourceRef="G-P1" targetRef="Merge_NoGo" name="No-Go" />
    <bpmn:sequenceFlow id="F_06" sourceRef="Merge_Research" targetRef="Call_R2" />
<bpmn:sequenceFlow id="F_06b" sourceRef="Call_R2" targetRef="SP2.1" />
    <bpmn:sequenceFlow id="F_07" sourceRef="SP2.1" targetRef="SP2.2" />
    <bpmn:sequenceFlow id="F_08" sourceRef="SP2.2" targetRef="Call_R3" />
<bpmn:sequenceFlow id="F_08b" sourceRef="Call_R3" targetRef="SP3.1" />
    <bpmn:sequenceFlow id="F_09" sourceRef="SP3.1" targetRef="Call_PG2" />
    <bpmn:sequenceFlow id="F_10" sourceRef="Call_PG2" targetRef="G-P2" />
    <bpmn:sequenceFlow id="F_P2_ja" sourceRef="G-P2" targetRef="Merge_Mapping" name="Ja (validiert)" />
    <bpmn:sequenceFlow id="F_P2_research" sourceRef="G-P2" targetRef="Merge_Research" name="Mehr Research" />
    <bpmn:sequenceFlow id="F_P2_pivot" sourceRef="G-P2" targetRef="Merge_P1" name="Pivot" />
    <bpmn:sequenceFlow id="F_P2_nogo" sourceRef="G-P2" targetRef="Merge_NoGo" name="No-Go" />
    <bpmn:sequenceFlow id="F_NoGo" sourceRef="Merge_NoGo" targetRef="S_NoGo" />
    <bpmn:sequenceFlow id="F_NoGo_2" sourceRef="S_NoGo" targetRef="End_IdeeVerworfen" />
    <bpmn:sequenceFlow id="F_11" sourceRef="Merge_Mapping" targetRef="SP4.1" />
    <bpmn:sequenceFlow id="F_12" sourceRef="SP4.1" targetRef="SP4.2" />
    <bpmn:sequenceFlow id="F_13" sourceRef="SP4.2" targetRef="Call_PG3" />
    <bpmn:sequenceFlow id="F_14" sourceRef="Call_PG3" targetRef="G-P3" />
    <bpmn:sequenceFlow id="F_P3_ja" sourceRef="G-P3" targetRef="Merge_Refinement" name="Ja" />
    <bpmn:sequenceFlow id="F_P3_nachschaerfen" sourceRef="G-P3" targetRef="Merge_Mapping" name="Nachschaerfen" />
    <bpmn:sequenceFlow id="F_15" sourceRef="Merge_Refinement" targetRef="SP5.1" />
    <bpmn:sequenceFlow id="F_16" sourceRef="SP5.1" targetRef="SP56" />
    <bpmn:sequenceFlow id="F_17" sourceRef="SP56" targetRef="G-Split" />
    <bpmn:sequenceFlow id="F_Split_nein" sourceRef="G-Split" targetRef="Merge_AC" name="Nein" />
    <bpmn:sequenceFlow id="F_Split_ja" sourceRef="G-Split" targetRef="Merge_Refinement" name="Ja (Re-Splitting)" />
    <bpmn:sequenceFlow id="F_18" sourceRef="Merge_AC" targetRef="SP6.2" />
    <bpmn:sequenceFlow id="F_19" sourceRef="SP6.2" targetRef="G-6.2" />
    <bpmn:sequenceFlow id="F_62_ja" sourceRef="G-6.2" targetRef="S7" name="Ja" />
    <bpmn:sequenceFlow id="F_62_nein" sourceRef="G-6.2" targetRef="Merge_AC" name="Nein" />
    <bpmn:sequenceFlow id="F_20" sourceRef="S7" targetRef="End_StoryReady" />
</bpmn:process>
<bpmn:process id="Process_R" name="Recherche durchfuehren" isExecutable="false"><bpmn:documentation>Wiederverwendbarer Recherche-Prozess (Gedaechtnis SS8). Beim ersten Aufruf eines Korpus: Deep Research + WebSearch (+ optional DDG); bei erneutem Aufruf desselben Korpus (Gap-Fill) nur WebSearch auf die Luecken. R_3b fuehrt das Claim-Ledger (Triangulation, Abdeckung gegen Pflicht-Scope SS8.2); hoechstens eine gezielte Nachsuche (R_2d), danach Synthese nur aus Ledger-Claims.</bpmn:documentation>

<bpmn:startEvent id="R_Start" name="Recherche angefordert"><bpmn:outgoing>R_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:businessRuleTask id="R_1" name="Fragestellung schaerfen &amp; Tool routen"><bpmn:documentation>Rolle: Researcher. Input: offene Fragestellung. Output: Tool-Routing-Entscheidung.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.1" agentRole="researcher" modelRole="research" kind="llm" /></bpmn:extensionElements><bpmn:incoming>R_F1</bpmn:incoming><bpmn:outgoing>R_F2</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:parallelGateway id="R_Split"><bpmn:incoming>R_F2</bpmn:incoming><bpmn:outgoing>R_F3a</bpmn:outgoing><bpmn:outgoing>R_F3b</bpmn:outgoing><bpmn:outgoing>R_F3c</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="R_2a" name="Deep-Research-Auftrag stellen"><bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.2a" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:research tool="deep-research" purpose="corpus" /></bpmn:extensionElements><bpmn:incoming>R_F3a</bpmn:incoming><bpmn:outgoing>R_F4a</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="R_2b" name="Web-Suche durchfuehren"><bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.2b" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:research tool="websearch" purpose="factcheck" /></bpmn:extensionElements><bpmn:incoming>R_F3b</bpmn:incoming><bpmn:outgoing>R_F4b</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="R_2c" name="Bulk-URL-Discovery via DuckDuckGo"><bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat. Optional, per Konfiguration standardmaessig aus; nie einzige Quelle eines Claims (Gedaechtnis SS8.0).</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.2c" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:research tool="ddg" purpose="discovery" /></bpmn:extensionElements><bpmn:incoming>R_F3c</bpmn:incoming><bpmn:outgoing>R_F4c</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="R_Join"><bpmn:incoming>R_F4a</bpmn:incoming><bpmn:incoming>R_F4b</bpmn:incoming><bpmn:incoming>R_F4c</bpmn:incoming><bpmn:outgoing>R_F5</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="R_Merge"><bpmn:incoming>R_F5</bpmn:incoming><bpmn:incoming>R_F10</bpmn:incoming><bpmn:outgoing>R_F5b</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="R_3" name="Quellen normalisieren, hashen &amp; deduplizieren"><bpmn:documentation>Rolle: Researcher. Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.3" agentRole="researcher" modelRole="none" kind="deterministic" /><sdlc:output artifact="source" itemPrefix="SRC" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>R_F5b</bpmn:incoming><bpmn:outgoing>R_F6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="R_3b" name="Claims extrahieren &amp; Abdeckung pruefen"><bpmn:documentation>Rolle: Researcher. Fuehrt das Claim-Ledger (CLM): je Claim Quellen, Tier, Datum, trianguliert ja/nein; prueft gegen den Pflicht-Scope (Gedaechtnis SS8.2/SS8.4) und schreibt die Lueckenliste. Untriangulierte Kern-Claims nach der Nachsuche werden auf inferred herabgestuft (SS8.4).</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.3b" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:input artifact="source" required="true" /><sdlc:output artifact="claim-ledger" itemPrefix="CLM" /></bpmn:extensionElements><bpmn:incoming>R_F6</bpmn:incoming><bpmn:outgoing>R_F6b</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_Gw" name="Luecken?"><bpmn:incoming>R_F6b</bpmn:incoming><bpmn:outgoing>R_F8</bpmn:outgoing><bpmn:outgoing>R_F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="R_2d" name="Luecken gezielt nachsuchen"><bpmn:documentation>Rolle: Researcher. Hoechstens einmal pro Aufruf: WebSearch + Rohtext-Abruf gezielt auf die Lueckenliste aus R_3b (Gedaechtnis SS8.5). Kein Deep-Research-Aufruf.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="R.2d" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:research tool="websearch" purpose="gapfill" /></bpmn:extensionElements><bpmn:incoming>R_F8</bpmn:incoming><bpmn:outgoing>R_F10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="R_4" name="Recherche-Synthese mit Zitaten verfassen"><bpmn:extensionElements><sdlc:step key="R.4" agentRole="researcher" modelRole="research" kind="llm" /><sdlc:output artifact="research-synthese" /></bpmn:extensionElements><bpmn:incoming>R_F9</bpmn:incoming><bpmn:outgoing>R_F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="R_End" name="Recherche abgeschlossen"><bpmn:incoming>R_F7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="R_F1" sourceRef="R_Start" targetRef="R_1" />
    <bpmn:sequenceFlow id="R_F2" sourceRef="R_1" targetRef="R_Split" />
    <bpmn:sequenceFlow id="R_F3a" sourceRef="R_Split" targetRef="R_2a" />
    <bpmn:sequenceFlow id="R_F3b" sourceRef="R_Split" targetRef="R_2b" />
    <bpmn:sequenceFlow id="R_F3c" sourceRef="R_Split" targetRef="R_2c" />
    <bpmn:sequenceFlow id="R_F4a" sourceRef="R_2a" targetRef="R_Join" />
    <bpmn:sequenceFlow id="R_F4b" sourceRef="R_2b" targetRef="R_Join" />
    <bpmn:sequenceFlow id="R_F4c" sourceRef="R_2c" targetRef="R_Join" />
    <bpmn:sequenceFlow id="R_F5" sourceRef="R_Join" targetRef="R_Merge" />
    <bpmn:sequenceFlow id="R_F5b" sourceRef="R_Merge" targetRef="R_3" />
    <bpmn:sequenceFlow id="R_F6" sourceRef="R_3" targetRef="R_3b" />
    <bpmn:sequenceFlow id="R_F6b" sourceRef="R_3b" targetRef="R_Gw" />
    <bpmn:sequenceFlow id="R_F8" sourceRef="R_Gw" targetRef="R_2d" name="Ja (einmal)"><bpmn:extensionElements><sdlc:condition expr="gaps &gt; 0 &amp;&amp; gapFillRound &lt; 1" /></bpmn:extensionElements></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R_F9" sourceRef="R_Gw" targetRef="R_4" name="Nein / schon nachgesucht"><bpmn:extensionElements><sdlc:condition expr="gaps == 0 || gapFillRound &gt;= 1" /></bpmn:extensionElements></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="R_F10" sourceRef="R_2d" targetRef="R_Merge" />
    <bpmn:sequenceFlow id="R_F7" sourceRef="R_4" targetRef="R_End" />
</bpmn:process>
<bpmn:process id="Process_K" name="Kritiker-Pruefung" isExecutable="false">

<bpmn:startEvent id="K_Start" name="Pruefung angefordert"><bpmn:outgoing>K_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:scriptTask id="K_1" name="Rubric laden"><bpmn:documentation>Rolle: Kritiker. Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="K.1" agentRole="kritiker" modelRole="none" kind="deterministic" /></bpmn:extensionElements><bpmn:incoming>K_F1</bpmn:incoming><bpmn:outgoing>K_F2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:businessRuleTask id="K_2" name="Artefakt gegen Rubric bewerten"><bpmn:extensionElements><sdlc:step key="K.2" agentRole="kritiker" modelRole="critic" kind="llm" /></bpmn:extensionElements><bpmn:incoming>K_F2</bpmn:incoming><bpmn:outgoing>K_F3</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="K_Gw1" name="Claims strittig?"><bpmn:incoming>K_F3</bpmn:incoming><bpmn:outgoing>K_F4a</bpmn:outgoing><bpmn:outgoing>K_F4b</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="K_3" name="Strittige Claims faktenchecken" calledElement="Process_R"><bpmn:extensionElements><sdlc:step key="K.3" agentRole="kritiker" modelRole="research" kind="llm" /><sdlc:research tool="websearch" purpose="factcheck" /></bpmn:extensionElements><bpmn:incoming>K_F4a</bpmn:incoming><bpmn:outgoing>K_F5</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="K_Merge"><bpmn:incoming>K_F4b</bpmn:incoming><bpmn:incoming>K_F5</bpmn:incoming><bpmn:outgoing>K_F6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="K_4" name="Verdikt bilden &amp; Loop-Cap anwenden"><bpmn:documentation>Rolle: Kritiker. Deterministisch: score&gt;=threshold -&gt; pass; sonst pass-with-risk ab maxLoops.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="K.4" agentRole="kritiker" modelRole="none" kind="deterministic" /></bpmn:extensionElements><bpmn:incoming>K_F6</bpmn:incoming><bpmn:outgoing>K_F7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="K_5" name="Gate-Record schreiben"><bpmn:extensionElements><sdlc:step key="K.5" agentRole="kritiker" modelRole="none" kind="deterministic" /><sdlc:output artifact="gate-record" itemPrefix="G" /></bpmn:extensionElements><bpmn:incoming>K_F7</bpmn:incoming><bpmn:outgoing>K_F8</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="K_End" name="Verdikt vorliegt"><bpmn:incoming>K_F8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="K_F1" sourceRef="K_Start" targetRef="K_1" />
    <bpmn:sequenceFlow id="K_F2" sourceRef="K_1" targetRef="K_2" />
    <bpmn:sequenceFlow id="K_F3" sourceRef="K_2" targetRef="K_Gw1" />
    <bpmn:sequenceFlow id="K_F4a" sourceRef="K_Gw1" targetRef="K_3" name="Ja" />
    <bpmn:sequenceFlow id="K_F4b" sourceRef="K_Gw1" targetRef="K_Merge" name="Nein" />
    <bpmn:sequenceFlow id="K_F5" sourceRef="K_3" targetRef="K_Merge" />
    <bpmn:sequenceFlow id="K_F6" sourceRef="K_Merge" targetRef="K_4" />
    <bpmn:sequenceFlow id="K_F7" sourceRef="K_4" targetRef="K_5" />
    <bpmn:sequenceFlow id="K_F8" sourceRef="K_5" targetRef="K_End" />
</bpmn:process>
<bpmn:process id="Process_P" name="Panel befragen" isExecutable="false">

<bpmn:laneSet id="LaneSet_Process_P"><bpmn:lane id="Lane_P_INT" name="Interviewer"><bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>P_1</bpmn:flowNodeRef><bpmn:flowNodeRef>P_3</bpmn:flowNodeRef><bpmn:flowNodeRef>P_4</bpmn:flowNodeRef><bpmn:flowNodeRef>P_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_P_Panel" name="Synthetisches Panel"><bpmn:flowNodeRef>P_2</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="P_Start" name="Panel-Aufruf gestartet"><bpmn:outgoing>P_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P_1" name="Stimulus / Leitfaden vorbereiten"><bpmn:extensionElements><sdlc:step key="P.1" agentRole="interviewer" modelRole="producer" kind="llm" /></bpmn:extensionElements><bpmn:incoming>P_F1</bpmn:incoming><bpmn:outgoing>P_F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P_2" name="Persona befragen"><bpmn:extensionElements><sdlc:step key="P.2" agentRole="persona" modelRole="persona" kind="llm" /></bpmn:extensionElements><bpmn:incoming>P_F2</bpmn:incoming><bpmn:outgoing>P_F3</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:extensionElements><sdlc:collection ref="panel-profiles[panelSet]" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics></bpmn:serviceTask>
    <bpmn:scriptTask id="P_3" name="Transkript / Antworten erfassen"><bpmn:documentation>Rolle: Interviewer. Deterministisch, kein LLM.</bpmn:documentation><bpmn:extensionElements><sdlc:step key="P.3" agentRole="interviewer" modelRole="none" kind="deterministic" /><sdlc:output artifact="interview-transcripts" itemPrefix="T" cardinality="many" /></bpmn:extensionElements><bpmn:incoming>P_F3</bpmn:incoming><bpmn:outgoing>P_F4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="P_4" name="Synthese / Votum bilden"><bpmn:extensionElements><sdlc:step key="P.4" agentRole="interviewer" modelRole="producer" kind="llm" /></bpmn:extensionElements><bpmn:incoming>P_F4</bpmn:incoming><bpmn:outgoing>P_F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P_End" name="Panel-Ergebnis vorliegt"><bpmn:incoming>P_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P_F1" sourceRef="P_Start" targetRef="P_1" />
    <bpmn:sequenceFlow id="P_F2" sourceRef="P_1" targetRef="P_2" />
    <bpmn:sequenceFlow id="P_F3" sourceRef="P_2" targetRef="P_3" />
    <bpmn:sequenceFlow id="P_F4" sourceRef="P_3" targetRef="P_4" />
    <bpmn:sequenceFlow id="P_F5" sourceRef="P_4" targetRef="P_End" />
</bpmn:process>
<bpmn:process id="Process_PG" name="Phasen-Gate-Review" isExecutable="false">

<bpmn:laneSet id="LaneSet_Process_PG"><bpmn:lane id="Lane_PG_KRI" name="Kritiker"><bpmn:flowNodeRef>PG_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>PG_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>PG_Call_K</bpmn:flowNodeRef><bpmn:flowNodeRef>PG_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>PG_1</bpmn:flowNodeRef><bpmn:flowNodeRef>PG_End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_PG_INT" name="Interviewer"><bpmn:flowNodeRef>PG_Call_P</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="PG_Start" name="Phasen-Gate angefordert"><bpmn:outgoing>PG_F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="PG_Split"><bpmn:incoming>PG_F1</bpmn:incoming><bpmn:outgoing>PG_F2a</bpmn:outgoing><bpmn:outgoing>PG_F2b</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:callActivity id="PG_Call_K" name="Kritiker-Pruefung aufrufen" calledElement="Process_K"><bpmn:extensionElements><sdlc:step key="PG.K" agentRole="kritiker" modelRole="critic" kind="llm" /></bpmn:extensionElements><bpmn:incoming>PG_F2a</bpmn:incoming><bpmn:outgoing>PG_F3a</bpmn:outgoing></bpmn:callActivity>
    <bpmn:callActivity id="PG_Call_P" name="Panel befragen (vote)" calledElement="Process_P"><bpmn:extensionElements><sdlc:step key="PG.P" agentRole="interviewer" modelRole="persona" kind="llm" /><sdlc:panel mode="vote" panelSet="full" optional="false" /></bpmn:extensionElements><bpmn:incoming>PG_F2b</bpmn:incoming><bpmn:outgoing>PG_F3b</bpmn:outgoing></bpmn:callActivity>
    <bpmn:parallelGateway id="PG_Join"><bpmn:incoming>PG_F3a</bpmn:incoming><bpmn:incoming>PG_F3b</bpmn:incoming><bpmn:outgoing>PG_F4</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:businessRuleTask id="PG_1" name="Verdikt aggregieren"><bpmn:documentation>Regel: Kritiker pass UND Panel-Mehrheitsvotum (Contrarian/Verweigerer zaehlen nicht zur Mehrheit, siehe Gedaechtnis §9.2).</bpmn:documentation><bpmn:extensionElements><sdlc:step key="PG.1" agentRole="kritiker" modelRole="critic" kind="llm" /><sdlc:output artifact="gate-record" itemPrefix="G" /></bpmn:extensionElements><bpmn:incoming>PG_F4</bpmn:incoming><bpmn:outgoing>PG_F5</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:endEvent id="PG_End" name="Phasen-Gate-Verdikt vorliegt"><bpmn:incoming>PG_F5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="PG_F1" sourceRef="PG_Start" targetRef="PG_Split" />
    <bpmn:sequenceFlow id="PG_F2a" sourceRef="PG_Split" targetRef="PG_Call_K" />
    <bpmn:sequenceFlow id="PG_F2b" sourceRef="PG_Split" targetRef="PG_Call_P" />
    <bpmn:sequenceFlow id="PG_F3a" sourceRef="PG_Call_K" targetRef="PG_Join" />
    <bpmn:sequenceFlow id="PG_F3b" sourceRef="PG_Call_P" targetRef="PG_Join" />
    <bpmn:sequenceFlow id="PG_F4" sourceRef="PG_Join" targetRef="PG_1" />
