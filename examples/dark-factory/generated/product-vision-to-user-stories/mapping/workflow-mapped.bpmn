  <bpmn:process id="Process_R" name="Recherche durchfuehren" isExecutable="false">
    <bpmn:documentation>Wiederverwendbarer Recherche-Prozess (Gedaechtnis SS8). Beim ersten Aufruf eines Korpus: Deep Research + WebSearch (+ optional DDG); bei erneutem Aufruf desselben Korpus (Gap-Fill) nur WebSearch auf die Luecken. R_3b fuehrt das Claim-Ledger (Triangulation, Abdeckung gegen Pflicht-Scope SS8.2); hoechstens eine gezielte Nachsuche (R_2d), danach Synthese nur aus Ledger-Claims.</bpmn:documentation>
    <bpmn:startEvent id="R_Start" name="Recherche angefordert">
      <bpmn:outgoing>R_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="R_1" name="Fragestellung schaerfen &#38; Tool routen">
      <bpmn:documentation>Rolle: Researcher. Input: offene Fragestellung. Output: Tool-Routing-Entscheidung.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.1" agentRole="researcher" modelRole="research" kind="llm" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F1</bpmn:incoming>
      <bpmn:outgoing>R_F2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:parallelGateway id="R_Split">
      <bpmn:incoming>R_F2</bpmn:incoming>
      <bpmn:outgoing>R_F3a</bpmn:outgoing>
      <bpmn:outgoing>R_F3b</bpmn:outgoing>
      <bpmn:outgoing>R_F3c</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="R_2a" name="Deep-Research-Auftrag stellen">
      <bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.2a" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:research tool="deep-research" purpose="corpus" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F3a</bpmn:incoming>
      <bpmn:outgoing>R_F4a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_2b" name="Web-Suche durchfuehren">
      <bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.2b" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:research tool="websearch" purpose="factcheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F3b</bpmn:incoming>
      <bpmn:outgoing>R_F4b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_2c" name="Bulk-URL-Discovery via DuckDuckGo">
      <bpmn:documentation>No-Op, falls R.1 dieses Tool nicht ausgewaehlt hat. Optional, per Konfiguration standardmaessig aus; nie einzige Quelle eines Claims (Gedaechtnis SS8.0).</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.2c" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:research tool="ddg" purpose="discovery" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F3c</bpmn:incoming>
      <bpmn:outgoing>R_F4c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="R_Join">
      <bpmn:incoming>R_F4a</bpmn:incoming>
      <bpmn:incoming>R_F4b</bpmn:incoming>
      <bpmn:incoming>R_F4c</bpmn:incoming>
      <bpmn:outgoing>R_F5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="R_Merge">
      <bpmn:incoming>R_F5</bpmn:incoming>
      <bpmn:incoming>R_F10</bpmn:incoming>
      <bpmn:outgoing>R_F5b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="R_3" name="Quellen normalisieren, hashen &#38; deduplizieren">
      <bpmn:documentation>Rolle: Researcher. Deterministisch, kein LLM.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.3" agentRole="researcher" modelRole="none" kind="deterministic" />
        <sdlc:output artifact="source" itemPrefix="SRC" cardinality="many" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F5b</bpmn:incoming>
      <bpmn:outgoing>R_F6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="R_3b" name="Claims extrahieren &#38; Abdeckung pruefen">
      <bpmn:documentation>Rolle: Researcher. Fuehrt das Claim-Ledger (CLM): je Claim Quellen, Tier, Datum, trianguliert ja/nein; prueft gegen den Pflicht-Scope (Gedaechtnis SS8.2/SS8.4) und schreibt die Lueckenliste. Untriangulierte Kern-Claims nach der Nachsuche werden auf inferred herabgestuft (SS8.4).</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.3b" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:input artifact="source" required="true" />
        <sdlc:output artifact="claim-ledger" itemPrefix="CLM" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F6</bpmn:incoming>
      <bpmn:outgoing>R_F6b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_Gw" name="Luecken?">
      <bpmn:incoming>R_F6b</bpmn:incoming>
      <bpmn:outgoing>R_F8</bpmn:outgoing>
      <bpmn:outgoing>R_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="R_2d" name="Luecken gezielt nachsuchen">
      <bpmn:documentation>Rolle: Researcher. Hoechstens einmal pro Aufruf: WebSearch + Rohtext-Abruf gezielt auf die Lueckenliste aus R_3b (Gedaechtnis SS8.5). Kein Deep-Research-Aufruf.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R.2d" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:research tool="websearch" purpose="gapfill" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F8</bpmn:incoming>
      <bpmn:outgoing>R_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_4" name="Recherche-Synthese mit Zitaten verfassen">
      <bpmn:extensionElements>
        <sdlc:step key="R.4" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:output artifact="research-synthese" />
      </bpmn:extensionElements>
      <bpmn:incoming>R_F9</bpmn:incoming>
      <bpmn:outgoing>R_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="R_End" name="Recherche abgeschlossen">
      <bpmn:incoming>R_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="R_F1" sourceRef="R_Start" targetRef="R_1" />
    <bpmn:sequenceFlow id="R_F2" sourceRef="R_1" targetRef="R_Split" />
    <bpmn:sequenceFlow id="R_F3a" sourceRef="R_Split" targetRef="R_2a" />
