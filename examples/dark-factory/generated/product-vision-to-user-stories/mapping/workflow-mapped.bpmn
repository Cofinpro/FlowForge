<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:sdlc="urn:dark-factory:sdlc:1.0" id="Definitions_ProduktvisionZuUserStories" targetNamespace="https://example.com/bpmn/produktvision-zu-user-stories">
  <bpmn:error id="Error_BudgetErschoepft" name="Budget erschoepft" errorCode="BUDGET_EXHAUSTED" />
  <bpmn:process id="Process_ProduktvisionZuUserStories" name="Von der Produktvision zu User Stories &#38; Akzeptanzkriterien (Dark Factory)" isExecutable="false">
    <bpmn:documentation>Dark-Factory-BPMN-Modell: vollautonomer Ablauf von der Geschaeftsidee zu sprint-reifen User Stories mit Akzeptanzkriterien, ohne menschlichen Eingriff (Q1). Kein Schritt beurteilt sein eigenes Ergebnis: innere Gates ruft der wiederverwendbare Kritiker-Prozess (Process_K) auf, die drei Phasen-Gates (G-P1/G-P2/G-P3) der Phasen-Gate-Review-Prozess (Process_PG, Kritiker + synthetisches Panel). Evidenz stammt aus Recherche (Process_R: Gemini Deep Research API, Claude WebSearch, Rohtext-Abruf; Claim-Ledger mit Triangulation) und einem research-gegroundeten synthetischen Nutzerpanel (Process_P). Details zu Rollen, Evidenzstufen, Panel-Aufbau, Gate-Regeln, Item-IDs und Rubrics: docs/dark-factory/process-rules.md.</bpmn:documentation>
    <bpmn:startEvent id="Start_Geschaeftsidee" name="Geschaeftsidee / Marktbedarf erkannt">
      <bpmn:outgoing>F_00</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="S0" name="0 Idee-Brief vervollstaendigen">
      <bpmn:documentation>Rolle: Stratege. Vervollstaendigt Freitext/Idee-Brief; abgeleitete Felder als Annahme (ASM) markiert.</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="0" agentRole="stratege" modelRole="producer" kind="llm" />
        <sdlc:input artifact="idea-brief" required="false" />
        <sdlc:output artifact="idea-brief" />
        <sdlc:research tool="websearch" purpose="factcheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_00</bpmn:incoming>
      <bpmn:outgoing>F_01</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_DO_Idea">
        <bpmn:targetRef>DataRef_DO_Idea</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_R1" name="Recherche: Markt &#38; Wettbewerb (DR-01)" calledElement="Process_R">
      <bpmn:documentation>Rolle: Researcher. Ruft Process_R auf (Gemini Deep Research, Korpusaufbau). Laeuft einmal vor der Vision-Schleife, damit Kritiker-Retries in 1.1 keinen zusaetzlichen Deep-Research-Aufruf ausloesen; ein Rueckweg nach Pivot durchlaeuft ihn nicht erneut (Budget-Hard-Cap, Gedaechtnis SS8.1/SS9.4).</bpmn:documentation>
      <bpmn:extensionElements>
        <sdlc:step key="R1" agentRole="researcher" modelRole="research" kind="llm" />
        <sdlc:output artifact="research-markt-wettbewerb" />
        <sdlc:research tool="deep-research" purpose="corpus" ref="DR-01" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_01</bpmn:incoming>
      <bpmn:outgoing>F_01b</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Merge_P1">
      <bpmn:incoming>F_01b</bpmn:incoming>
      <bpmn:incoming>F_P1_nachschaerfen</bpmn:incoming>
      <bpmn:incoming>F_P2_pivot</bpmn:incoming>
      <bpmn:outgoing>F_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP1.1" name="1.1 Produktvision &#38; Geschaeftsmodell rahmen">
      <bpmn:documentation>Rolle: Stratege / Researcher / UX. Input: Idee-Brief (0), Recherche DR-01. Output: Artefakt 1.</bpmn:documentation>
      <bpmn:incoming>F_02</bpmn:incoming>
      <bpmn:outgoing>F_03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_DO_A1">
        <bpmn:targetRef>DataRef_DO_A1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="LaneSet_SP1.1">
        <bpmn:lane id="Lane_SP1.1_stratege" name="Stratege">
          <bpmn:flowNodeRef>SP1.1_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.1_Merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.1.1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.1.2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.1.3</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.1.6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP1.1_researcher" name="Researcher">
          <bpmn:flowNodeRef>S1.1.4</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP1.1_ux" name="UX-/Journey-Designer">
          <bpmn:flowNodeRef>S1.1.5</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP1.1_kritiker" name="Kritiker">
          <bpmn:flowNodeRef>SP1.1_CallK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.1_Gw</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.1_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP1.1_Start" name="Gestartet">
        <bpmn:outgoing>SP1.1_F0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP1.1_Merge">
        <bpmn:incoming>SP1.1_F0</bpmn:incoming>
        <bpmn:incoming>SP1.1_F_nein</bpmn:incoming>
        <bpmn:outgoing>S1.1.1_in</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S1.1.1" name="Status quo &#38; Zielbild klaeren">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.1" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="idea-brief" required="true" />
          <sdlc:input artifact="research-markt-wettbewerb" required="true" />
          <sdlc:output artifact="zielbild" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.1_in</bpmn:incoming>
        <bpmn:outgoing>S1.1.2_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.1.2" name="Vision Statement &#38; Elevator Pitch formulieren">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.2" agentRole="stratege" modelRole="producer" kind="llm" skill="vision-statement-formulieren" />
          <sdlc:input artifact="zielbild" required="true" />
          <sdlc:output artifact="vision-statement" itemPrefix="VIS" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.2_in</bpmn:incoming>
        <bpmn:outgoing>S1.1.3_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.1.3" name="Lean / Business Model Canvas abbilden">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.3" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="vision-statement" required="true" />
          <sdlc:input artifact="research-markt-wettbewerb" required="true" />
          <sdlc:output artifact="lean-canvas" />
          <sdlc:research tool="websearch" purpose="factcheck" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.3_in</bpmn:incoming>
        <bpmn:outgoing>S1.1.4_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.1.4" name="Proto-Panel aus Research ableiten">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.4" agentRole="researcher" modelRole="producer" kind="llm" />
          <sdlc:input artifact="research-markt-wettbewerb" required="true" />
          <sdlc:output artifact="proto-panel" itemPrefix="P" cardinality="many" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.4_in</bpmn:incoming>
        <bpmn:outgoing>S1.1.5_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.1.5" name="Value Proposition Canvas abgleichen">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.5" agentRole="ux" modelRole="producer" kind="llm" />
          <sdlc:input artifact="lean-canvas" required="true" />
          <sdlc:input artifact="proto-panel" required="true" />
          <sdlc:output artifact="value-proposition-canvas" />
          <sdlc:panel mode="rating" panelSet="proto" optional="false" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.5_in</bpmn:incoming>
        <bpmn:outgoing>S1.1.6_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.1.6" name="Annahmen in Assumptions Map priorisieren">
        <bpmn:extensionElements>
          <sdlc:step key="S1.1.6" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="value-proposition-canvas" required="true" />
          <sdlc:input artifact="lean-canvas" required="true" />
          <sdlc:output artifact="assumptions-map" itemPrefix="ASM" cardinality="many" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.1.6_in</bpmn:incoming>
        <bpmn:outgoing>SP1.1_F_toK</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:callActivity id="SP1.1_CallK" name="Kritiker-Pruefung aufrufen (phase-1-1)" calledElement="Process_K">
        <bpmn:extensionElements>
          <sdlc:step key="SP1.1.K" agentRole="kritiker" modelRole="critic" kind="llm" />
          <sdlc:critic rubric="phase-1-1" threshold="0.8" maxLoops="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SP1.1_F_toK</bpmn:incoming>
        <bpmn:outgoing>SP1.1_F_toGw</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="SP1.1_Gw" name="Geschaeftsmodell tragfaehig &#38; UVP klar?">
        <bpmn:incoming>SP1.1_F_toGw</bpmn:incoming>
        <bpmn:outgoing>SP1.1_F_ja</bpmn:outgoing>
        <bpmn:outgoing>SP1.1_F_nein</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP1.1_End" name="Vision &#38; Geschaeftsmodell entworfen">
        <bpmn:incoming>SP1.1_F_ja</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP1.1_F0" sourceRef="SP1.1_Start" targetRef="SP1.1_Merge" />
      <bpmn:sequenceFlow id="S1.1.1_in" sourceRef="SP1.1_Merge" targetRef="S1.1.1" />
      <bpmn:sequenceFlow id="S1.1.2_in" sourceRef="S1.1.1" targetRef="S1.1.2" />
      <bpmn:sequenceFlow id="S1.1.3_in" sourceRef="S1.1.2" targetRef="S1.1.3" />
      <bpmn:sequenceFlow id="S1.1.4_in" sourceRef="S1.1.3" targetRef="S1.1.4" />
      <bpmn:sequenceFlow id="S1.1.5_in" sourceRef="S1.1.4" targetRef="S1.1.5" />
      <bpmn:sequenceFlow id="S1.1.6_in" sourceRef="S1.1.5" targetRef="S1.1.6" />
      <bpmn:sequenceFlow id="SP1.1_F_toK" sourceRef="S1.1.6" targetRef="SP1.1_CallK" />
      <bpmn:sequenceFlow id="SP1.1_F_toGw" sourceRef="SP1.1_CallK" targetRef="SP1.1_Gw" />
      <bpmn:sequenceFlow id="SP1.1_F_ja" name="Ja (ggf. mit Risiko-Flag)" sourceRef="SP1.1_Gw" targetRef="SP1.1_End" />
      <bpmn:sequenceFlow id="SP1.1_F_nein" name="Nein" sourceRef="SP1.1_Gw" targetRef="SP1.1_Merge" />
      <bpmn:textAnnotation id="MapAnnot_4_TextAnnotation">
        <bpmn:text>Nicht generiert: Start/end event of the collapsed '1.1 Produktvision &amp; Geschaeftsmodell rahmen' scope — its c…</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_4_Association" sourceRef="SP1.1_Start" targetRef="MapAnnot_4_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_5_TextAnnotation">
        <bpmn:text>Skill: product-zielbild-klaeren, product-stratege.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_5_Association" sourceRef="S1.1.1" targetRef="MapAnnot_5_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_6_TextAnnotation">
        <bpmn:text>Skill: product-vision-statement-formulieren, product-stratege.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_6_Association" sourceRef="S1.1.2" targetRef="MapAnnot_6_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_7_TextAnnotation">
        <bpmn:text>Skill: product-lean-canvas-abbilden, product-stratege.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_7_Association" sourceRef="S1.1.3" targetRef="MapAnnot_7_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_8_TextAnnotation">
        <bpmn:text>Skill: product-proto-panel-ableiten, product-researcher.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_8_Association" sourceRef="S1.1.4" targetRef="MapAnnot_8_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_9_TextAnnotation">
        <bpmn:text>Skill: product-value-proposition-canvas-abgleichen, product-ux.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_9_Association" sourceRef="S1.1.5" targetRef="MapAnnot_9_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_10_TextAnnotation">
        <bpmn:text>Skill: product-assumptions-map-priorisieren, product-stratege.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_10_Association" sourceRef="S1.1.6" targetRef="MapAnnot_10_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_11_TextAnnotation">
        <bpmn:text>Skill: product-kritiker-pruefung, product-kritiker.md</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_11_Association" sourceRef="SP1.1_CallK" targetRef="MapAnnot_11_TextAnnotation" />
      <bpmn:textAnnotation id="MapAnnot_12_TextAnnotation">
        <bpmn:text>Nicht generiert: Start/end event of the collapsed '1.1 Produktvision &amp; Geschaeftsmodell rahmen' scope — its c…</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MapAnnot_12_Association" sourceRef="SP1.1_End" targetRef="MapAnnot_12_TextAnnotation" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SP1.2" name="1.2 Impact Mapping &#38; Business-Ziele definieren">
      <bpmn:documentation>Rolle: Stratege / UX. Input: Vision Statement (Artefakt 1). Output: Artefakt 2.</bpmn:documentation>
      <bpmn:incoming>F_03</bpmn:incoming>
      <bpmn:outgoing>F_04</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_DO_A2">
        <bpmn:targetRef>DataRef_DO_A2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="LaneSet_SP1.2">
        <bpmn:lane id="Lane_SP1.2_stratege" name="Stratege">
          <bpmn:flowNodeRef>SP1.2_Start</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.2_Merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.2.1</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.2.2</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.2.4</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.2.5</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>S1.2.6</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP1.2_ux" name="UX-/Journey-Designer">
          <bpmn:flowNodeRef>S1.2.3</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_SP1.2_kritiker" name="Kritiker">
          <bpmn:flowNodeRef>SP1.2_CallK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.2_Gw</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>SP1.2_End</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="SP1.2_Start" name="Gestartet">
        <bpmn:outgoing>SP1.2_F0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="SP1.2_Merge">
        <bpmn:incoming>SP1.2_F0</bpmn:incoming>
        <bpmn:incoming>SP1.2_F_nein</bpmn:incoming>
        <bpmn:outgoing>S1.2.1_in</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="S1.2.1" name="Ziel &#38; Kennzahlen festlegen (Why)">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.1" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="vision-statement" required="true" />
          <sdlc:output artifact="business-goals" itemPrefix="GOAL" cardinality="many" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.1_in</bpmn:incoming>
        <bpmn:outgoing>S1.2.2_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.2.2" name="Akteure identifizieren (Who)">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.2" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="business-goals" required="true" />
          <sdlc:input artifact="proto-panel" required="true" />
          <sdlc:output artifact="actors" itemPrefix="ACT" cardinality="many" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.2_in</bpmn:incoming>
        <bpmn:outgoing>S1.2.3_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.2.3" name="Verhaltensaenderungen ableiten (How)">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.3" agentRole="ux" modelRole="producer" kind="llm" />
          <sdlc:input artifact="actors" required="true" />
          <sdlc:output artifact="impacts" itemPrefix="IMP" cardinality="many" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.3_in</bpmn:incoming>
        <bpmn:outgoing>S1.2.4_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.2.4" name="Deliverables als Optionen sammeln (What)">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.4" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="impacts" required="true" />
          <sdlc:output artifact="impact-map" itemPrefix="DEL" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.4_in</bpmn:incoming>
        <bpmn:outgoing>S1.2.5_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.2.5" name="Impacts nach Hebel &#38; Risiko priorisieren">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.5" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="impact-map" required="true" />
          <sdlc:input artifact="assumptions-map" required="true" />
          <sdlc:output artifact="impact-scoring" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.5_in</bpmn:incoming>
        <bpmn:outgoing>S1.2.6_in</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="S1.2.6" name="Outcome-orientierte Roadmap ableiten">
        <bpmn:extensionElements>
          <sdlc:step key="S1.2.6" agentRole="stratege" modelRole="producer" kind="llm" />
          <sdlc:input artifact="impact-scoring" required="true" />
          <sdlc:output artifact="roadmap" />
        </bpmn:extensionElements>
        <bpmn:incoming>S1.2.6_in</bpmn:incoming>
        <bpmn:outgoing>SP1.2_F_toK</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:callActivity id="SP1.2_CallK" name="Kritiker-Pruefung aufrufen (phase-1-2)" calledElement="Process_K">
        <bpmn:extensionElements>
          <sdlc:step key="SP1.2.K" agentRole="kritiker" modelRole="critic" kind="llm" />
          <sdlc:critic rubric="phase-1-2" threshold="0.8" maxLoops="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>SP1.2_F_toK</bpmn:incoming>
        <bpmn:outgoing>SP1.2_F_toGw</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="SP1.2_Gw" name="Pfad zum Ziel plausibel?">
        <bpmn:incoming>SP1.2_F_toGw</bpmn:incoming>
        <bpmn:outgoing>SP1.2_F_ja</bpmn:outgoing>
        <bpmn:outgoing>SP1.2_F_nein</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP1.2_End" name="Impact Map &#38; Roadmap abgeleitet">
        <bpmn:incoming>SP1.2_F_ja</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP1.2_F0" sourceRef="SP1.2_Start" targetRef="SP1.2_Merge" />
