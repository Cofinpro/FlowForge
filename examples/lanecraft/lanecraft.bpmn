    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F43" sourceRef="Gw_Verify" targetRef="U_Befunde" name="Obergrenze erreicht">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Obergrenze erreicht</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F44" sourceRef="U_Befunde" targetRef="Gw_Befunde" />
