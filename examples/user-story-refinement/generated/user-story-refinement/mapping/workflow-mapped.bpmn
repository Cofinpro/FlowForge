        <bpmn:targetRef>Property_MethodikPhase6_P4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_DO_Plausi_Ref">
        <bpmn:targetRef>DO_Plausi_Ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Plausibel" name="Konsistent mit dem übrigen Backlog?" default="F72">
      <bpmn:incoming>F71</bpmn:incoming>
      <bpmn:outgoing>F72</bpmn:outgoing>
      <bpmn:outgoing>F73</bpmn:outgoing>
      <bpmn:outgoing>F74</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P6" name="Mit bestehender Story zusammenführen">
      <bpmn:documentation>Input: neue Story, gefundenes Duplikat. Output: bestehende Story um die neuen Akzeptanzkriterien und den Feedback-Link ergänzt; die neue Story entfällt.</bpmn:documentation>
      <bpmn:incoming>F74</bpmn:incoming>
      <bpmn:outgoing>F75</bpmn:outgoing>
      <bpmn:property id="Property_MethodikPhase6_P6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_MethodikPhase6_P6">
        <bpmn:sourceRef>StoreRef_MethodikPhase6</bpmn:sourceRef>
        <bpmn:targetRef>Property_MethodikPhase6_P6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_StoryZusammengefuehrt" name="Story in bestehende Story überführt">
      <bpmn:incoming>F75</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P5" name="Betroffene Stories zur Anpassung markieren">
      <bpmn:documentation>Input: Plausibilitätsbefund. Output: Abhängigkeitslinks und Anpassungshinweise an betroffenen oder überholten Stories. Ohne Befund entfällt dieser Schritt.</bpmn:documentation>
      <bpmn:incoming>F72</bpmn:incoming>
      <bpmn:outgoing>F80</bpmn:outgoing>
      <bpmn:property id="Property_MethodikPhase6_P5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_MethodikPhase6_P5">
