        <bpmn:targetRef>Property_MethodikPhase6_P5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="E4" name="Story priorisieren &#38; in Ready-Spalte stellen">
      <bpmn:documentation>Input: DoR-konforme, plausibilisierte Story. Output: priorisierte, sprint-reife User Story in der Ready-Spalte des Boards.</bpmn:documentation>
      <bpmn:incoming>F80</bpmn:incoming>
      <bpmn:outgoing>F81</bpmn:outgoing>
      <bpmn:property id="Property_MethodikPhase6_E4" name="__targetRef_placeholder" />
