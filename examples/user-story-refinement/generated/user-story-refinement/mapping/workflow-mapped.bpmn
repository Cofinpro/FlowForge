        <bpmn:targetRef>DO_ReadyStory_Ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_StorySprintReady" name="Story sprint-ready">
      <bpmn:incoming>F81</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_FeedbackEingegangen" targetRef="I1" />
    <bpmn:sequenceFlow id="F02" sourceRef="I1" targetRef="I2" />
    <bpmn:sequenceFlow id="F03" sourceRef="I2" targetRef="Gw_Bug" />
    <bpmn:sequenceFlow id="F04" name="Ja (Bug)" sourceRef="Gw_Bug" targetRef="End_BugUebergeben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja (Bug)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" name="Nein" sourceRef="Gw_Bug" targetRef="Gw_Bezug" />
    <bpmn:sequenceFlow id="F06" name="Ändert eine offene Story" sourceRef="Gw_Bezug" targetRef="End_AnStoryUebergeben">
