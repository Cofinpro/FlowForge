      <bpmn:outgoing>F78</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D5" name="Story Points schätzen (Planning Poker)">
      <bpmn:documentation>Input: Story-Karte, Akzeptanzkriterien, technischer Ansatz. Output: relative Schätzung in Story Points, vom Team gemeinsam verantwortet.</bpmn:documentation>
