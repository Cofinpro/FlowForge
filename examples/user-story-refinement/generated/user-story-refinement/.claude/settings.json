{
  "permissions": {
    "allow": [
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh project view:*)",
      "Bash(gh project item-list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/user-story-refinement-write-guard.mjs"
          }
        ]
      }
    ]
  }
}
