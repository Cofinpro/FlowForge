      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nutzen / Bedienbarkeit unklar</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22" sourceRef="Gw_Unsicherheit" targetRef="B4" name="Technisch unklar">
