<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_UserStoryErstellenVerfeinern" targetNamespace="https://example.com/bpmn/user-story-erstellen-verfeinern">
  <bpmn:category id="Category_Group_Phase1"><bpmn:categoryValue id="CategoryValue_Group_Phase1" value="1 Eingang &amp; Triage" /></bpmn:category>
  <bpmn:category id="Category_Group_Phase2"><bpmn:categoryValue id="CategoryValue_Group_Phase2" value="2 Fachliche Klärung" /></bpmn:category>
  <bpmn:category id="Category_Group_Phase3"><bpmn:categoryValue id="CategoryValue_Group_Phase3" value="3 Story formulieren" /></bpmn:category>
  <bpmn:category id="Category_Group_Phase4"><bpmn:categoryValue id="CategoryValue_Group_Phase4" value="4 Refinement (Three Amigos)" /></bpmn:category>
  <bpmn:category id="Category_Group_Phase5"><bpmn:categoryValue id="CategoryValue_Group_Phase5" value="5 Definition of Ready" /></bpmn:category>
  <bpmn:category id="Category_Group_Phase6"><bpmn:categoryValue id="CategoryValue_Group_Phase6" value="6 Plausibilität gegen Backlog &amp; Freigabe" /></bpmn:category>
  <bpmn:process id="Process_UserStoryErstellenVerfeinern" name="Neue User Story aus Feedback erstellen &amp; verfeinern" isExecutable="false">
    <bpmn:documentation>Weg einer neuen User Story in einem laufenden IT-Projekt: Produktvision, Epics, Fachkonzept und Backlog existieren bereits. Auslöser ist Feedback von Nutzern oder Stakeholdern. Triage (Bug, Änderung an offener Story, neue Story unter einem Epic, parken), leichtgewichtige fachliche Klärung gegen Epic-Ziel und Fachkonzept, Spike oder Prototyp nur bei echter Unsicherheit, Story formulieren und gegen INVEST prüfen, Three-Amigos-Refinement, Definition of Ready und abschließend eine Plausibilitätsprüfung gegen die übrigen Stories im Backlog (Duplikate, widersprüchliche Akzeptanzkriterien, Abhängigkeiten, Ablaufkonsistenz). Wissensbasis: NotebookLM-Notebook &quot;The Product - Business Design&quot;.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_UserStory">
      <bpmn:lane id="Lane_ProductOwner" name="Product Owner / BA">
        <bpmn:flowNodeRef>Start_FeedbackEingegangen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Bug</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BugUebergeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Bezug</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AnStoryUebergeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FeedbackGeparkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fachkonzept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FachkonzeptAenderung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_KlaerungSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_KlaerungJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Unsicherheit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Erkenntnis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AnliegenVerworfen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Einordnung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Formulierung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Invest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Refinement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_AmigosSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Sprintgroesse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StoryVerworfen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_PlausiSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_PlausiJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Plausibel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StoryZusammengefuehrt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_StorySprintReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UxResearchDesign" name="UX &amp; Design">
        <bpmn:flowNodeRef>K5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Validierung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Entwicklung" name="Entwicklung / Tech Lead">
        <bpmn:flowNodeRef>K4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Schaetzung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Schaetzung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QaTest" name="QA / Test">
        <bpmn:flowNodeRef>D2c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Par_AmigosJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_FeedbackEingegangen" name="Nutzer- oder Stakeholder-Feedback eingegangen">
      <bpmn:documentation>Quellen: Support-Tickets, Nutzerfeedback (Reviews, In-App-Feedback, Usability-Beobachtung), Anmerkungen aus dem Sprint Review, Change Requests von Stakeholdern. Rahmen besteht bereits: Produktvision, Epics, Fachkonzept mit Domänenmodell, laufendes Product Backlog.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="I1" name="Feedback erfassen &amp; als Problem formulieren">
      <bpmn:documentation>Input: Rohfeedback, Quelle und Absender. Output: Feedback-Eintrag - beobachtetes Problem statt gewünschter Lösung ('Ich muss Abweichungen schneller finden' statt 'Ich brauche einen Excel-Export'), betroffene Nutzerrolle, Häufigkeit, Dringlichkeit, Link zur Quelle.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Feedback_Ref"><bpmn:targetRef>DO_Feedback_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="I2" name="Verwandte Stories &amp; Epics im Backlog suchen">
      <bpmn:documentation>Input: Feedback-Eintrag, Product Backlog, User Story Map, Epics. Output: Kandidatenliste verwandter Stories (offen, in Arbeit, erledigt) und der passende Epic bzw. Impact-Zweig, jeweils mit Begründung.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:property id="Property_DO_Backlog_Ref" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DO_Backlog_Ref"><bpmn:sourceRef>DO_Backlog_Ref</bpmn:sourceRef><bpmn:targetRef>Property_DO_Backlog_Ref</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Bug" name="Fehlverhalten einer bestehenden Funktion?" default="F05">
      <bpmn:documentation>Bug = das System weicht von vereinbarten Akzeptanzkriterien oder Fachregeln ab. Kleine Bugs laufen über die Fehlerbearbeitung; erfordert die Korrektur neue Fähigkeiten oder geänderte Abläufe, ist es eine Story.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_BugUebergeben" name="An Fehlerbearbeitung übergeben">
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Bezug" name="Wie hängt das Anliegen mit dem Backlog zusammen?" default="F08">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AnStoryUebergeben" name="Als Änderung an offene Story übergeben">
      <bpmn:documentation>Betrifft das Feedback eine Story, die noch im Refinement oder in Arbeit ist, werden deren Akzeptanzkriterien angepasst statt eine neue Story anzulegen.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_FeedbackGeparkt" name="Feedback im Opportunity Backlog geparkt">
      <bpmn:documentation>Kein Bezug zu einem bestehenden Epic oder Ziel, kein erkennbarer Nutzen, abgelaufene Frist oder reiner Technik-Wunsch ohne Nutzerproblem.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="K1" name="Anliegen mit Feedbackgeber klären">
      <bpmn:documentation>Input: Feedback-Eintrag, Kandidatenliste. Output: kurze Rückfrage beim Nutzer oder Stakeholder bestätigt - Problem hinter dem Wunsch, gewünschtes Ergebnis, Dringlichkeit, Ansprechpartner für das Refinement.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="K2" name="Gegen Epic-Ziel &amp; Fachkonzept prüfen">
      <bpmn:documentation>Input: bestätigtes Anliegen, Epic mit Ziel-KPI, Fachkonzept (Fachregeln, Domänenmodell, Ubiquitous Language). Output: Befund - unterstützt das Anliegen das Epic-Ziel, welche Fachregeln und Begriffe sind betroffen, widerspricht es dem Fachkonzept?</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:property id="Property_DO_Fachkonzept_Ref" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DO_Fachkonzept_Ref"><bpmn:sourceRef>DO_Fachkonzept_Ref</bpmn:sourceRef><bpmn:targetRef>Property_DO_Fachkonzept_Ref</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Fachkonzept" name="Mit dem Fachkonzept vereinbar?" default="F12">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_FachkonzeptAenderung" name="Fachkonzept-Änderung beantragt">
      <bpmn:documentation>Das Anliegen verlangt eine Änderung an Fachregeln oder am Domänenmodell. Das entscheiden Fachbereich und Stakeholder, bevor eine Story entsteht.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Par_KlaerungSplit">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="K3" name="Ist-/Soll-Delta beschreiben">
      <bpmn:documentation>Input: Befund zu Epic und Fachkonzept, Feedback-Eintrag. Output: Ist-/Soll-Delta - wie verhält sich das System heute, wie nach der Story, was gehört ausdrücklich nicht dazu.</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_ScopeDelta_Ref"><bpmn:targetRef>DO_ScopeDelta_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K5" name="Betroffene Screens &amp; Abläufe identifizieren">
      <bpmn:documentation>Input: Feedback-Eintrag, bestehende Wireframes und Design-System. Output: betroffene Screens, Interaktionsfluss, wiederverwendbare Muster.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K4" name="Technische Auswirkungen grob einschätzen">
      <bpmn:documentation>Input: Feedback-Eintrag, Architektur, betroffene Komponenten. Output: grobe Größe, betroffene Schnittstellen, offene technische Risiken (unbekannte APIs, Performance, Compliance-Grenzen).</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Par_KlaerungJoin">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_Unsicherheit" name="Relevante Unsicherheit offen?" default="F20">
      <bpmn:documentation>Nur bei echter Unsicherheit eskalieren - ein Feedback innerhalb eines bestehenden Epics braucht keinen vollständigen Discovery-Zyklus.</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="K6" name="Klickbaren Prototyp mit Nutzern testen">
      <bpmn:documentation>Input: betroffene Screens, Feedback-Eintrag, vorab definierte Erfolgskriterien. Output: Prototyp und Testergebnisse mit 3-5 Nutzern (Nutzerzitate, erfüllt / nicht erfüllt).</bpmn:documentation>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Testing_Ref"><bpmn:targetRef>DO_Testing_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="B4" name="Time-boxed Spike durchführen">
      <bpmn:documentation>Input: offenes technisches Risiko, feste Timebox (1-3 Tage), Akzeptanzkriterien des Spikes. Output: Spike-Report (machbar ja/nein, Architektur-Randbedingungen).</bpmn:documentation>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Spike_Ref"><bpmn:targetRef>DO_Spike_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_Validierung">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="B5" name="Erkenntnisse auswerten">
      <bpmn:documentation>Input: Spike-Report oder Testergebnisse, Ist-/Soll-Delta. Output: Entscheidung weitermachen oder verwerfen mit Begründung; ggf. angepasstes Delta.</bpmn:documentation>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Erkenntnis" name="Tragen die Erkenntnisse die Story?" default="F27">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AnliegenVerworfen" name="Anliegen verworfen">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge_Einordnung">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C1" name="Story unter Epic in User Story Map einordnen">
      <bpmn:documentation>Input: Feedback-Eintrag, Epic, User Story Map (Backbone aus Aktivitäten und Nutzer-Tasks). Output: Platz der Story unter ihrem Nutzer-Task im Epic-Zweig.</bpmn:documentation>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_Formulierung">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:incoming>F52</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C2" name="Story im Connextra-Format formulieren">
      <bpmn:documentation>Input: Platz in der Story Map, Nutzerrolle aus dem Fachkonzept, Problemformulierung, Ist-/Soll-Delta. Output: Story-Karte 'Als [Rolle] möchte ich [Ziel], damit [Nutzen]' - Nutzerziel statt 'Das System soll ...'. Die Karte ist ein Platzhalter für ein Gespräch, kein Vertrag.</bpmn:documentation>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_StoryKarte_Ref"><bpmn:targetRef>DO_StoryKarte_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C3" name="Bezug zu Epic, Fachkonzept &amp; Feedback dokumentieren">
      <bpmn:documentation>Input: Story-Karte, Epic, Fachkonzept, Feedback-Eintrag. Output: Traceability-Eintrag Vision -&gt; Geschäftsziel -&gt; Epic -&gt; User Story, betroffene Fachkonzept-Kapitel und Link zum auslösenden Feedback.</bpmn:documentation>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="C4" name="INVEST-Selbstcheck durchführen">
      <bpmn:documentation>Input: Story-Karte. Output: INVEST-Befund (Independent, Negotiable, Valuable, Estimable, Small, Testable) je Kriterium.</bpmn:documentation>
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Invest" name="INVEST erfüllt?" default="F35">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Merge_Refinement">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:incoming>F58</bpmn:incoming>
      <bpmn:incoming>F61</bpmn:incoming>
      <bpmn:incoming>F73</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D1" name="Refinement mit Three Amigos ansetzen">
      <bpmn:documentation>Input: Story-Karte, INVEST-Befund. Output: Refinement-Termin mit PO/BA, Entwicklung und QA (Power of Three), UX bei Bedarf; Feedbackgeber optional eingeladen.</bpmn:documentation>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Par_AmigosSplit">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="D2a" name="Wert &amp; Fachregeln erläutern (Was)">
      <bpmn:documentation>Input: Story-Karte, Fachkonzept, Ist-/Soll-Delta. Output: Fachregeln, gewünschtes Ergebnis, Wert - das 'Was', nicht das 'Wie'.</bpmn:documentation>
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D2d" name="Wireframes &amp; Interaktionsfluss beilegen">
      <bpmn:documentation>Input: betroffene Screens, bestehende Wireframes, Prototyp (falls getestet). Output: Wireframes/Mockups und Interaktionsfluss an der Story.</bpmn:documentation>
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D2b" name="Umsetzung &amp; Abhängigkeiten klären (Wie)">
      <bpmn:documentation>Input: Story-Karte, technische Grobeinschätzung, Spike-Report (falls vorhanden), Architektur. Output: technischer Ansatz, Abhängigkeiten zu anderen Stories/Teams, Risiken.</bpmn:documentation>
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D2c" name="Randfälle &amp; Negativszenarien identifizieren">
      <bpmn:documentation>Input: Story-Karte, Fachregeln. Output: Liste von Grenzwerten, ungültigen Eingaben und Systemgrenzen (Testheuristiken).</bpmn:documentation>
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Par_AmigosJoin">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="D3" name="Akzeptanzkriterien in Given-When-Then formulieren">
      <bpmn:documentation>Input: Fachregeln, Rand- und Negativfälle, Wireframes. Output: Akzeptanzkriterien als BDD-Szenarien (Gegeben / Wenn / Dann) auf der Rückseite der Karte.</bpmn:documentation>
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:outgoing>F76</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Akzeptanz_Ref"><bpmn:targetRef>DO_Akzeptanz_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D4" name="Beispieltabellen ergänzen (Specification by Example)">
      <bpmn:documentation>Input: Akzeptanzkriterien. Output: Beispieltabellen mit konkreten Werten statt abstrakter Regeln.</bpmn:documentation>
      <bpmn:incoming>F76</bpmn:incoming>
      <bpmn:outgoing>F77</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_Schaetzung">
      <bpmn:incoming>F77</bpmn:incoming>
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:outgoing>F78</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D5" name="Story Points schätzen (Planning Poker)">
      <bpmn:documentation>Input: Story-Karte, Akzeptanzkriterien, technischer Ansatz. Output: relative Schätzung in Story Points, vom Team gemeinsam verantwortet.</bpmn:documentation>
      <bpmn:incoming>F78</bpmn:incoming>
      <bpmn:outgoing>F79</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Schaetzung_Ref"><bpmn:targetRef>DO_Schaetzung_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Schaetzung" name="Schätzungen konvergiert?" default="F48">
      <bpmn:incoming>F79</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
      <bpmn:outgoing>F49</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Sprintgroesse" name="Passt die Story in einen Sprint?" default="F50">
      <bpmn:incoming>F48</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
      <bpmn:outgoing>F51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="D6" name="Story vertikal schneiden (Splitting-Muster)">
      <bpmn:documentation>Input: zu große Story, Akzeptanzkriterien. Output: kleinere Teil-Stories (1-3 Tage) durch vertikalen Schnitt: Slice the Cake, Basisnutzen zuerst, Referenzdaten fest verdrahten, Backend 'auf Krücken'. Jede Teil-Story wird neu formuliert.</bpmn:documentation>
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="E1" name="Definition of Ready prüfen">
      <bpmn:documentation>Input: verfeinerte Story, Akzeptanzkriterien, Schätzung. Output: DoR-Befund: INVEST erfüllt, konkrete Rolle statt 'der Nutzer', Akzeptanzkriterien bestätigt, Wireframes vorhanden, keine offenen Blocker, Größe unter Kapazitätsgrenze.</bpmn:documentation>
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F53</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="E2" name="Begriffe mit Domänenmodell abgleichen">
      <bpmn:documentation>Input: Story-Karte, Akzeptanzkriterien, Domänenmodell aus dem Fachkonzept. Output: Abweichungen von der Ubiquitous Language (Entitäten, Rollen, Regeln).</bpmn:documentation>
      <bpmn:incoming>F53</bpmn:incoming>
      <bpmn:outgoing>F54</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="E3" name="Auf Fake- &amp; Waisen-Story prüfen">
      <bpmn:documentation>Input: Story-Karte, Traceability-Eintrag. Output: Befund, ob die Story ein verkleideter Entwickler-Task oder ohne Bezug zu Epic/Ziel ist.</bpmn:documentation>
      <bpmn:incoming>F54</bpmn:incoming>
      <bpmn:outgoing>F55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Ready" name="Definition of Ready erfüllt?" default="F57">
      <bpmn:incoming>F55</bpmn:incoming>
      <bpmn:outgoing>F57</bpmn:outgoing>
      <bpmn:outgoing>F58</bpmn:outgoing>
      <bpmn:outgoing>F59</bpmn:outgoing>
      <bpmn:outgoing>F60</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="E5" name="Nachgelagerten Spike durchführen">
      <bpmn:documentation>Input: im DoR-Check entdecktes technisches Risiko. Output: Spike-Report; die Story geht danach erneut ins Refinement.</bpmn:documentation>
      <bpmn:incoming>F59</bpmn:incoming>
      <bpmn:outgoing>F61</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_StoryVerworfen" name="Story verworfen">
      <bpmn:incoming>F60</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Par_PlausiSplit">
      <bpmn:incoming>F57</bpmn:incoming>
      <bpmn:outgoing>F62</bpmn:outgoing>
      <bpmn:outgoing>F63</bpmn:outgoing>
      <bpmn:outgoing>F64</bpmn:outgoing>
      <bpmn:outgoing>F65</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="P1" name="Auf Duplikate &amp; Überschneidungen prüfen">
      <bpmn:documentation>Input: Story-Karte, Product Backlog (offene und erledigte Stories). Output: Stories mit gleichem oder überlappendem Ziel, gleiche Konzepte unter anderem Namen ('Splitter').</bpmn:documentation>
      <bpmn:incoming>F62</bpmn:incoming>
      <bpmn:outgoing>F66</bpmn:outgoing>
      <bpmn:property id="Property_DO_Backlog_Ref2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DO_Backlog_Ref2"><bpmn:sourceRef>DO_Backlog_Ref2</bpmn:sourceRef><bpmn:targetRef>Property_DO_Backlog_Ref2</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P7" name="Konsistenz mit bestehenden Abläufen prüfen">
      <bpmn:documentation>Input: Wireframes der Story, Wireframes anderer Stories im selben Nutzer-Task. Output: Abweichungen von bestehenden Interaktionsmustern und UI-Begriffen.</bpmn:documentation>
      <bpmn:incoming>F63</bpmn:incoming>
      <bpmn:outgoing>F67</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3" name="Abhängigkeiten &amp; Reihenfolge prüfen">
      <bpmn:documentation>Input: technischer Ansatz, Backlog, nichtfunktionale Ziele des Release. Output: Vorgänger-/Nachfolger-Stories, geteilte Komponenten, Konflikte mit Sicherheits-, Performance- oder Kapazitätszielen.</bpmn:documentation>
      <bpmn:incoming>F64</bpmn:incoming>
      <bpmn:outgoing>F68</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2" name="Akzeptanzkriterien gegen bestehende Stories abgleichen">
      <bpmn:documentation>Input: Given-When-Then-Szenarien, Akzeptanzkriterien anderer Stories, Living Documentation. Output: widersprüchliche Szenarien und Fachregeln mit Fundstelle.</bpmn:documentation>
      <bpmn:incoming>F65</bpmn:incoming>
      <bpmn:outgoing>F69</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Par_PlausiJoin">
      <bpmn:incoming>F66</bpmn:incoming>
      <bpmn:incoming>F67</bpmn:incoming>
      <bpmn:incoming>F68</bpmn:incoming>
      <bpmn:incoming>F69</bpmn:incoming>
      <bpmn:outgoing>F70</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="P4" name="Plausibilitätsbefund zusammenführen">
      <bpmn:documentation>Input: Befunde zu Duplikaten, Abläufen, Abhängigkeiten und Akzeptanzkriterien. Output: Plausibilitätsbefund - Duplikate, Widersprüche, Abhängigkeiten und betroffene Stories, je mit Fundstelle.</bpmn:documentation>
      <bpmn:incoming>F70</bpmn:incoming>
      <bpmn:outgoing>F71</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_Plausi_Ref"><bpmn:targetRef>DO_Plausi_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Plausibel" name="Konsistent mit dem übrigen Backlog?" default="F72">
      <bpmn:incoming>F71</bpmn:incoming>
      <bpmn:outgoing>F72</bpmn:outgoing>
      <bpmn:outgoing>F73</bpmn:outgoing>
      <bpmn:outgoing>F74</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P6" name="Mit bestehender Story zusammenführen">
      <bpmn:documentation>Input: neue Story, gefundenes Duplikat. Output: bestehende Story um die neuen Akzeptanzkriterien und den Feedback-Link ergänzt; die neue Story entfällt.</bpmn:documentation>
      <bpmn:incoming>F74</bpmn:incoming>
      <bpmn:outgoing>F75</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_StoryZusammengefuehrt" name="Story in bestehende Story überführt">
      <bpmn:incoming>F75</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P5" name="Betroffene Stories zur Anpassung markieren">
      <bpmn:documentation>Input: Plausibilitätsbefund. Output: Abhängigkeitslinks und Anpassungshinweise an betroffenen oder überholten Stories. Ohne Befund entfällt dieser Schritt.</bpmn:documentation>
      <bpmn:incoming>F72</bpmn:incoming>
      <bpmn:outgoing>F80</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="E4" name="Story priorisieren &amp; in Ready-Spalte stellen">
      <bpmn:documentation>Input: DoR-konforme, plausibilisierte Story. Output: priorisierte, sprint-reife User Story in der Ready-Spalte des Boards.</bpmn:documentation>
      <bpmn:incoming>F80</bpmn:incoming>
      <bpmn:outgoing>F81</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DO_ReadyStory_Ref"><bpmn:targetRef>DO_ReadyStory_Ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_StorySprintReady" name="Story sprint-ready">
      <bpmn:incoming>F81</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_FeedbackEingegangen" targetRef="I1" />
    <bpmn:sequenceFlow id="F02" sourceRef="I1" targetRef="I2" />
