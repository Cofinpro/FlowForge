<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PrReview" targetNamespace="https://example.com/bpmn/pr-review">
  <bpmn:dataStore id="DataStore_Richtlinien" />
  <bpmn:dataStore id="DataStore_Repo" />
  <bpmn:process id="Process_PrReview" name="Pull Request prüfen und mergen" isExecutable="false">
    <bpmn:documentation>Der Weg eines Pull Requests bis zum Merge: eine KI fasst die Änderung zusammen und prüft Code, Tests und Sicherheit parallel, fasst die Befunde zusammen und schickt den Autor bei kritischen Befunden zurück. Den Merge gibt immer der Tech Lead frei. Wissensbasis: die Review-Richtlinien des Teams.</bpmn:documentation>
    <bpmn:ioSpecification id="IoSpec_PrReview">
      <bpmn:dataInput id="DataInput_PrNummer" name="PR-Nummer" />
      <bpmn:inputSet id="InputSet_PrReview">
        <bpmn:dataInputRefs>DataInput_PrNummer</bpmn:dataInputRefs>
      </bpmn:inputSet>
      <bpmn:outputSet id="OutputSet_PrReview" />
    </bpmn:ioSpecification>
    <bpmn:laneSet id="LaneSet_PrReview">
      <bpmn:lane id="Lane_Autor" name="Autor">
        <bpmn:flowNodeRef>Start_PrEroeffnet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Merge_Nachbessern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nachbessern</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reviewer" name="Reviewer">
        <bpmn:flowNodeRef>Gw_Merge_Pruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zusammenfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split_Pruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CodePruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sicherheit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_Pruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zusammenfuehren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Kritisch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TechLead" name="Tech Lead">
        <bpmn:flowNodeRef>Task_Freigeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Freigegeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mergen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Gemergt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Verworfen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PrEroeffnet" name="Pull Request eröffnet">
      <bpmn:documentation>Auslöser: Ein Entwickler öffnet einen Pull Request. Input: PR-Nummer.</bpmn:documentation>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_Merge_Pruefung">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Zusammenfassen" name="Änderung zusammenfassen">
      <bpmn:documentation>Input: PR-Nummer, Diff und Beschreibung des Pull Requests. Output: Kurzfassung der Änderung - was ändert sich, welche Dateien und Module sind betroffen, wie groß ist das Risiko.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:property id="Property_DataIn_Repo_Zusammenfassen" name="__targetRef_placeholder" />
      <bpmn:property id="Property_DataIn_PrNummer_Zusammenfassen" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_Repo_Zusammenfassen">
        <bpmn:sourceRef>StoreRef_Repo</bpmn:sourceRef>
        <bpmn:targetRef>Property_DataIn_Repo_Zusammenfassen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataIn_PrNummer_Zusammenfassen">
        <bpmn:sourceRef>DataInput_PrNummer</bpmn:sourceRef>
        <bpmn:targetRef>Property_DataIn_PrNummer_Zusammenfassen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_Split_Pruefung">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_CodePruefen" name="Code auf Fehler und Stil prüfen">
      <bpmn:documentation>Input: Kurzfassung der Änderung, Review-Richtlinien des Teams. Output: Befunde zu Logikfehlern, Lesbarkeit und Stil, je mit Datei, Zeile und Schweregrad.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:property id="Property_DataIn_Richtlinien_CodePruefen" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_Richtlinien_CodePruefen">
        <bpmn:sourceRef>StoreRef_Richtlinien</bpmn:sourceRef>
        <bpmn:targetRef>Property_DataIn_Richtlinien_CodePruefen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Tests" name="Tests und Linter ausführen">
      <bpmn:documentation>Input: Branch des Pull Requests. Output: Ergebnis von Testsuite und Linter (bestanden oder fehlgeschlagen, Liste der Fehler). Rein mechanisch.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Sicherheit" name="Sicherheitsrisiken prüfen">
      <bpmn:documentation>Input: Kurzfassung der Änderung, Diff. Output: Befunde zu Geheimnissen im Code, unsicherer Eingabeverarbeitung und neuen Abhängigkeiten, je mit Schweregrad.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_Join_Pruefung">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Zusammenfuehren" name="Befunde zusammenführen">
      <bpmn:documentation>Input: Befunde aus Code-Prüfung, Tests und Sicherheitsprüfung. Output: Review-Befund - dedupliziert, nach Schweregrad sortiert, mit Empfehlung (kritisch oder unkritisch).</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Befund_Zusammenfuehren">
        <bpmn:targetRef>DataObjRef_Befund</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Kritisch" name="Kritische Befunde?" default="Flow_13">
      <bpmn:documentation>Kritisch ist ein Befund mit Schweregrad hoch, ein fehlgeschlagener Test oder ein Sicherheitsrisiko. Nach höchstens drei Runden geht der Pull Request trotzdem zur Freigabe, mit Risikohinweis.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Merge_Nachbessern">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Nachbessern" name="Änderungen nachbessern">
      <bpmn:documentation>Input: Review-Befund. Output: neue Commits im Pull Request, die die Befunde beheben.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:property id="Property_DataIn_Befund_Nachbessern" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_Befund_Nachbessern">
        <bpmn:sourceRef>DataObjRef_Befund</bpmn:sourceRef>
        <bpmn:targetRef>Property_DataIn_Befund_Nachbessern</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Freigeben" name="Merge freigeben">
      <bpmn:documentation>Input: Kurzfassung der Änderung, Review-Befund. Output: Entscheidung des Tech Leads - freigeben, nachbessern lassen oder verwerfen. Freigabe vor dem Schreiben ins Repository.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Freigegeben" name="Freigegeben?" default="Flow_17">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Mergen" name="Pull Request mergen">
      <bpmn:documentation>Input: freigegebener Pull Request. Output: gemergter Branch, Pull Request geschlossen.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Repo_Mergen">
        <bpmn:targetRef>StoreRef_Repo</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Gemergt" name="Pull Request gemergt">
      <bpmn:documentation>Der Pull Request ist im Hauptzweig.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Verworfen" name="Pull Request verworfen">
      <bpmn:documentation>Der Tech Lead hat den Pull Request abgelehnt; der Autor bekommt eine Übergabenotiz.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_PrEroeffnet" targetRef="Gw_Merge_Pruefung" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gw_Merge_Pruefung" targetRef="Task_Zusammenfassen" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Zusammenfassen" targetRef="Gw_Split_Pruefung" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gw_Split_Pruefung" targetRef="Task_CodePruefen" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gw_Split_Pruefung" targetRef="Task_Tests" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gw_Split_Pruefung" targetRef="Task_Sicherheit" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CodePruefen" targetRef="Gw_Join_Pruefung" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Tests" targetRef="Gw_Join_Pruefung" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Sicherheit" targetRef="Gw_Join_Pruefung" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_Join_Pruefung" targetRef="Task_Zusammenfuehren" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Zusammenfuehren" targetRef="Gw_Kritisch" />
    <bpmn:sequenceFlow id="Flow_12" name="Ja (max. 3×)" sourceRef="Gw_Kritisch" targetRef="Gw_Merge_Nachbessern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja (max. 3×)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Nein" sourceRef="Gw_Kritisch" targetRef="Task_Freigeben" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gw_Merge_Nachbessern" targetRef="Task_Nachbessern" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Nachbessern" targetRef="Gw_Merge_Pruefung" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Freigeben" targetRef="Gw_Freigegeben" />
    <bpmn:sequenceFlow id="Flow_17" name="Ja" sourceRef="Gw_Freigegeben" targetRef="Task_Mergen" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Mergen" targetRef="End_Gemergt" />
    <bpmn:sequenceFlow id="Flow_19" name="Nein (max. 3×)" sourceRef="Gw_Freigegeben" targetRef="Gw_Merge_Nachbessern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nein (max. 3×)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Verworfen" sourceRef="Gw_Freigegeben" targetRef="End_Verworfen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Verworfen</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:dataObject id="DataObj_Befund" />
    <bpmn:dataObjectReference id="DataObjRef_Befund" name="Review-Befund" dataObjectRef="DataObj_Befund" />
    <bpmn:dataStoreReference id="StoreRef_Richtlinien" name="Review-Richtlinien" dataStoreRef="DataStore_Richtlinien">
      <bpmn:documentation>Art: wissen
Ort: datei:docs/review-guidelines.md</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="StoreRef_Repo" name="Pull Requests im Repository" dataStoreRef="DataStore_Repo">
      <bpmn:documentation>Art: live
Ort: cli:gh</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:textAnnotation id="MapAnnot_1_TextAnnotation">
      <bpmn:text>Process input: pr-nummer</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_1_Association" sourceRef="DataInput_PrNummer" targetRef="MapAnnot_1_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_2_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_2_Association" sourceRef="Start_PrEroeffnet" targetRef="MapAnnot_2_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_3_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_3_Association" sourceRef="Gw_Merge_Pruefung" targetRef="MapAnnot_3_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_4_TextAnnotation">
      <bpmn:text>Skill: pr-summary</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_4_Association" sourceRef="Task_Zusammenfassen" targetRef="MapAnnot_4_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_5_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_5_Association" sourceRef="Gw_Split_Pruefung" targetRef="MapAnnot_5_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_6_TextAnnotation">
      <bpmn:text>Skill: pr-code-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_6_Association" sourceRef="Task_CodePruefen" targetRef="MapAnnot_6_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_7_TextAnnotation">
      <bpmn:text>Script: run-tests-and-lint.mjs</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_7_Association" sourceRef="Task_Tests" targetRef="MapAnnot_7_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_8_TextAnnotation">
      <bpmn:text>OPEN QUESTION: Should the Pull Requests im Repository store also be drawn into "Code auf Fehler und Stil prüf…</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_8_Association" sourceRef="Task_Sicherheit" targetRef="MapAnnot_8_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_9_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_9_Association" sourceRef="Gw_Join_Pruefung" targetRef="MapAnnot_9_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_10_TextAnnotation">
      <bpmn:text>OPEN QUESTION: Should the Review-Richtlinien store be drawn into "Befunde zusammenführen" (it needs the sever…</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_10_Association" sourceRef="Task_Zusammenfuehren" targetRef="MapAnnot_10_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_11_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_11_Association" sourceRef="Gw_Kritisch" targetRef="MapAnnot_11_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_12_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_12_Association" sourceRef="Gw_Merge_Nachbessern" targetRef="MapAnnot_12_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_13_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_13_Association" sourceRef="Gw_Freigegeben" targetRef="MapAnnot_13_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_14_TextAnnotation">
      <bpmn:text>Skill: pr-merge</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_14_Association" sourceRef="Task_Mergen" targetRef="MapAnnot_14_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_15_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_15_Association" sourceRef="End_Gemergt" targetRef="MapAnnot_15_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_16_TextAnnotation">
      <bpmn:text>Orchestrator: pr-review</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_16_Association" sourceRef="End_Verworfen" targetRef="MapAnnot_16_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_17_TextAnnotation">
      <bpmn:text>Context source: knowledge · datei:docs/review-guidelines.md</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_17_Association" sourceRef="StoreRef_Richtlinien" targetRef="MapAnnot_17_TextAnnotation" />
    <bpmn:textAnnotation id="MapAnnot_18_TextAnnotation">
      <bpmn:text>Context source: live system · cli:gh</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="MapAnnot_18_Association" sourceRef="StoreRef_Repo" targetRef="MapAnnot_18_TextAnnotation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PrReview">
    <bpmndi:BPMNPlane id="BPMNPlane_PrReview" bpmnElement="Process_PrReview">
      <bpmndi:BPMNShape id="Lane_Autor_di" bpmnElement="Lane_Autor" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1790" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Reviewer_di" bpmnElement="Lane_Reviewer" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="1790" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TechLead_di" bpmnElement="Lane_TechLead" isHorizontal="true">
        <dc:Bounds x="160" y="730" width="1790" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_PrEroeffnet_di" bpmnElement="Start_PrEroeffnet" bioc:stroke="#006064" bioc:fill="#E0F7FA" color:background-color="#E0F7FA" color:border-color="#006064">
        <dc:Bounds x="330" y="117" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="303" y="85" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Merge_Pruefung_di" bpmnElement="Gw_Merge_Pruefung" isMarkerVisible="true" bioc:stroke="#006064" bioc:fill="#E0F7FA" color:background-color="#E0F7FA" color:border-color="#006064">
        <dc:Bounds x="400" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Zusammenfassen_di" bpmnElement="Task_Zusammenfassen" bioc:stroke="#1B5E20" bioc:fill="#E8F5E9" color:background-color="#E8F5E9" color:border-color="#1B5E20">
        <dc:Bounds x="500" y="470" width="140" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Split_Pruefung_di" bpmnElement="Gw_Split_Pruefung" bioc:stroke="#006064" bioc:fill="#E0F7FA" color:background-color="#E0F7FA" color:border-color="#006064">
        <dc:Bounds x="690" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CodePruefen_di" bpmnElement="Task_CodePruefen" bioc:stroke="#1B5E20" bioc:fill="#E8F5E9" color:background-color="#E8F5E9" color:border-color="#1B5E20">
        <dc:Bounds x="790" y="340" width="140" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Tests_di" bpmnElement="Task_Tests" bioc:stroke="#6A1B9A" bioc:fill="#F3E5F5" color:background-color="#F3E5F5" color:border-color="#6A1B9A">
