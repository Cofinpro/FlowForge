{
  "permissions": {
    "allow": ["{{readTool}}"]
  },
  "hooks": {
    "{{hookEvent}}": [
      {
        "matcher": "{{toolMatcher}}",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/{{hookName}}.mjs"
          }
        ]
      }
    ]
  }
}
