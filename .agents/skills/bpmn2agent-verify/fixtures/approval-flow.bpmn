<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ApprovalFlow" targetNamespace="https://example.com/bpmn/approval-flow">
  <bpmn:process id="Process_ApprovalFlow" name="Antragsgenehmigung" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ApprovalFlow">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1_Nummer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2_Grenzwert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>Gw_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3_Risiko</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4_Genehmigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Genehmigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Genehmigt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Antrag eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="S1_Nummer" name="Antragsnummer vergeben">
      <bpmn:documentation>Rolle: System. Input: Antrag (Rohdaten). Output: Antrag (nummeriert).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="S2_Grenzwert" name="Betrag &gt; Grenzwert pruefen">
      <bpmn:documentation>Rolle: System. Input: Antrag (nummeriert). Output: Grenzwert-Kennzeichen (ueber/unter Schwelle).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Merge">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S3_Risiko" name="Risikobewertung erstellen">
      <bpmn:documentation>Rolle: Sachbearbeiter. Input: Antrag (nummeriert). Output: Risikobewertung (Artefakt Antrag).</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Antrag">
        <bpmn:targetRef>DataRef_Antrag</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObject id="DataObject_Antrag" />
    <bpmn:dataObjectReference id="DataRef_Antrag" name="Antrag" dataObjectRef="DataObject_Antrag" />
    <bpmn:userTask id="S4_Genehmigen" name="Antrag genehmigen">
      <bpmn:documentation>Rolle: Sachbearbeiter. Input: Risikobewertung (Artefakt Antrag). Output: Genehmigungsentscheidung.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_S4_Genehmigen" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInAssoc_Antrag">
        <bpmn:sourceRef>DataRef_Antrag</bpmn:sourceRef>
        <bpmn:targetRef>Property_S4_Genehmigen</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Genehmigt" name="Genehmigt?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Genehmigt" name="Genehmigt">
      <bpmn:incoming>Flow_Ja</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="S1_Nummer" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="S1_Nummer" targetRef="S2_Grenzwert" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="S2_Grenzwert" targetRef="Gw_Merge" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_Merge" targetRef="S3_Risiko" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="S3_Risiko" targetRef="S4_Genehmigen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="S4_Genehmigen" targetRef="Gw_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Ja" name="Ja" sourceRef="Gw_Genehmigt" targetRef="End_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Nein" name="Nein (Nacharbeit)" sourceRef="Gw_Genehmigt" targetRef="Gw_Merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ApprovalFlow">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="140" y="60" width="1130" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sachbearbeiter_di" bpmnElement="Lane_Sachbearbeiter" isHorizontal="true">
        <dc:Bounds x="140" y="220" width="1130" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="180" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="160" y="158" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_Nummer_di" bpmnElement="S1_Nummer">
        <dc:Bounds x="280" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_Grenzwert_di" bpmnElement="S2_Grenzwert">
        <dc:Bounds x="460" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Merge_di" bpmnElement="Gw_Merge" isMarkerVisible="true">
        <dc:Bounds x="640" y="325" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S3_Risiko_di" bpmnElement="S3_Risiko">
        <dc:Bounds x="730" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataRef_Antrag_di" bpmnElement="DataRef_Antrag">
        <dc:Bounds x="755" y="235" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="745" y="205" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S4_Genehmigen_di" bpmnElement="S4_Genehmigen">
        <dc:Bounds x="910" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Genehmigt_di" bpmnElement="Gw_Genehmigt" isMarkerVisible="true">
        <dc:Bounds x="1090" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1075" y="378" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Genehmigt_di" bpmnElement="End_Genehmigt">
        <dc:Bounds x="1190" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1178" y="368" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="216" y="140" />
        <di:waypoint x="280" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="140" />
        <di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="560" y="140" />
        <di:waypoint x="665" y="140" />
        <di:waypoint x="665" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="690" y="350" />
        <di:waypoint x="730" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="830" y="350" />
        <di:waypoint x="910" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1010" y="350" />
        <di:waypoint x="1090" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ja_di" bpmnElement="Flow_Ja">
        <di:waypoint x="1140" y="350" />
        <di:waypoint x="1190" y="350" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1155" y="332" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nein_di" bpmnElement="Flow_Nein">
        <di:waypoint x="1115" y="375" />
        <di:waypoint x="1115" y="460" />
        <di:waypoint x="665" y="460" />
        <di:waypoint x="665" y="375" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="850" y="445" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutAssoc_Antrag_di" bpmnElement="DataOutAssoc_Antrag">
        <di:waypoint x="780" y="310" />
        <di:waypoint x="773" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInAssoc_Antrag_di" bpmnElement="DataInAssoc_Antrag">
        <di:waypoint x="791" y="262" />
        <di:waypoint x="960" y="310" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
