<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ContextFlowUnguarded" targetNamespace="https://example.com/bpmn/context-flow-unguarded">
  <bpmn:dataStore id="DataStore_Handbuch" />
  <bpmn:dataStore id="DataStore_Jira" />
  <bpmn:dataStore id="DataStore_Lernnotizen" />
  <bpmn:process id="Process_ContextFlowUnguarded" name="Ticket beantworten (ungeschützt)" isExecutable="false">
    <bpmn:ioSpecification id="IoSpec_1">
      <bpmn:dataInput id="DataInput_TicketId" name="Ticket-ID" />
      <bpmn:inputSet id="InputSet_1">
        <bpmn:dataInputRefs>DataInput_TicketId</bpmn:dataInputRefs>
      </bpmn:inputSet>
      <bpmn:outputSet id="OutputSet_1" />
    </bpmn:ioSpecification>
    <bpmn:laneSet id="LaneSet_ContextFlow">
      <bpmn:lane id="Lane_Support" name="Support-Agent">
        <bpmn:flowNodeRef>Start_TicketEingegangen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TicketAnalysieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AntwortEntwerfen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KommentarPosten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LernnotizFortschreiben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Beantwortet</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_TicketEingegangen" name="Ticket eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_TicketAnalysieren" name="Ticket analysieren">
      <bpmn:documentation>Input: Ticket-ID, Ticket aus Jira, Lernnotizen. Output: Analyse (Problem, Dringlichkeit). Quelle: ⚠ unverified</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_Analysieren_1" name="__targetRef_placeholder" />
      <bpmn:property id="Property_Analysieren_2" name="__targetRef_placeholder" />
      <bpmn:property id="Property_Analysieren_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInAssoc_Analysieren_1">
        <bpmn:sourceRef>DataInput_TicketId</bpmn:sourceRef>
        <bpmn:targetRef>Property_Analysieren_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInAssoc_Analysieren_2">
        <bpmn:sourceRef>StoreRef_Jira</bpmn:sourceRef>
        <bpmn:targetRef>Property_Analysieren_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInAssoc_Analysieren_3">
        <bpmn:sourceRef>StoreRef_Lernnotizen</bpmn:sourceRef>
        <bpmn:targetRef>Property_Analysieren_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Analyse">
        <bpmn:targetRef>DataRef_Analyse</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObject id="DataObject_Analyse" />
    <bpmn:dataObjectReference id="DataRef_Analyse" name="Analyse" dataObjectRef="DataObject_Analyse" />
    <bpmn:serviceTask id="Task_AntwortEntwerfen" name="Antwort entwerfen">
      <bpmn:documentation>Input: Analyse, Support-Handbuch. Output: Antwortentwurf. Quelle: ⚠ unverified</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_Entwerfen_1" name="__targetRef_placeholder" />
      <bpmn:property id="Property_Entwerfen_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInAssoc_Entwerfen_1">
        <bpmn:sourceRef>DataRef_Analyse</bpmn:sourceRef>
        <bpmn:targetRef>Property_Entwerfen_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInAssoc_Entwerfen_2">
        <bpmn:sourceRef>StoreRef_Handbuch</bpmn:sourceRef>
        <bpmn:targetRef>Property_Entwerfen_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_KommentarPosten" name="Kommentar im Ticket posten">
      <bpmn:documentation>Input: freigegebener Antwortentwurf. Output: Antwortprotokoll. Quelle: ⚠ unverified</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Jira">
        <bpmn:targetRef>StoreRef_Jira</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Protokoll">
        <bpmn:targetRef>DataRef_Protokoll</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObject id="DataObject_Protokoll" />
    <bpmn:dataObjectReference id="DataRef_Protokoll" name="Antwortprotokoll" dataObjectRef="DataObject_Protokoll" />
    <bpmn:serviceTask id="Task_LernnotizFortschreiben" name="Lernnotiz fortschreiben">
      <bpmn:documentation>Input: Ticket, Antwort. Output: aktualisierte Lernnotizen. Quelle: ⚠ unverified</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutAssoc_Lernnotizen">
        <bpmn:targetRef>StoreRef_Lernnotizen</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Beantwortet" name="Ticket beantwortet">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="StoreRef_Handbuch" name="Support-Handbuch" dataStoreRef="DataStore_Handbuch">
      <bpmn:documentation>Art: wissen
Ort: notebook:Support-Handbuch</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="StoreRef_Jira" name="Jira-Tickets Projekt LANE" dataStoreRef="DataStore_Jira">
      <bpmn:documentation>Art: live
Ort: mcp:atlassian</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="StoreRef_Lernnotizen" name="Lernnotizen Support" dataStoreRef="DataStore_Lernnotizen">
      <bpmn:documentation>Art: gedächtnis
Ort: datei:.claude/memory/context-flow/lernnotizen-support.md</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_TicketEingegangen" targetRef="Task_TicketAnalysieren" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TicketAnalysieren" targetRef="Task_AntwortEntwerfen" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_AntwortEntwerfen" targetRef="Task_KommentarPosten" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_KommentarPosten" targetRef="Task_LernnotizFortschreiben" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_LernnotizFortschreiben" targetRef="End_Beantwortet" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ContextFlowUnguarded">
      <bpmndi:BPMNShape id="Lane_Support_di" bpmnElement="Lane_Support" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1150" height="420" />
