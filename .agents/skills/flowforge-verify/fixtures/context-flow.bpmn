        <dc:Bounds x="1056" y="310" width="140" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LernnotizFortschreiben_di" bpmnElement="Task_LernnotizFortschreiben">
        <dc:Bounds x="1246" y="310" width="140" height="100" />
      </bpmndi:BPMNShape>
